# Copy this file to .env and fill in your values before running docker compose.
# .env is gitignored — never commit it.

# Required: Postgres password used by both the db and app services.
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=changeme

# Optional: host port to bind (default 8080). Set to a different value for staging.
# HOST_PORT=8081

# Local dev overrides (not needed for Docker Compose — entrypoint generates these):
# SESSION_SECRET=
# ENCRYPTION_KEY=
# DATABASE_URL=
# INSTALL_MODE=true    # force install wizard even when admin users exist
# SECURE_COOKIES=false # disable secure cookie flag for local HTTP
