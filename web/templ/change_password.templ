package admintempl

templ ChangePasswordPage(errMsg string) {
	@Layout("Change Password", "/change-password") {
		<div style="max-width: 28rem">
			<h1 class="title is-4 mb-4">Change Password</h1>
			<div class="box">
				@AlertBox(errMsg, "error")
				<form method="POST" action="/change-password">
					<div class="field">
						<label for="current_password" class="label is-small">
							Current Password <span class="has-text-danger" aria-hidden="true">*</span>
						</label>
						<div class="control">
							<input
								id="current_password"
								type="password"
								name="current_password"
								required
								autocomplete="current-password"
								class="input"
							/>
						</div>
					</div>
					<div class="field">
						<label for="new_password" class="label is-small">
							New Password <span class="has-text-danger" aria-hidden="true">*</span>
						</label>
						<div class="control">
							<input
								id="new_password"
								type="password"
								name="new_password"
								required
								minlength="8"
								autocomplete="new-password"
								class="input"
							/>
						</div>
					</div>
					<div class="field">
						<label for="confirm_password" class="label is-small">
							Confirm New Password <span class="has-text-danger" aria-hidden="true">*</span>
						</label>
						<div class="control">
							<input
								id="confirm_password"
								type="password"
								name="confirm_password"
								required
								autocomplete="new-password"
								class="input"
							/>
						</div>
					</div>
					<div class="field">
						<div class="control">
							<button type="submit" class="button is-primary">Update Password</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	}
}
