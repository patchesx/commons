package admintempl

import (
	"encoding/json"
	"fmt"

	"commons/plugin"
	"commons/store"
)

func webhookFormAlpineData(verifMode string, isEdit, hasSecret bool) string {
	b, _ := json.Marshal(verifMode)
	return fmt.Sprintf(`{ verif: %s, clearSecret: false, isEdit: %v, hasSecret: %v }`,
		string(b), isEdit, hasSecret)
}

func whFormName(wh *store.Webhook) string {
	if wh == nil {
		return ""
	}
	return wh.Name
}

func whFormSlug(wh *store.Webhook) string {
	if wh == nil {
		return ""
	}
	return wh.Slug
}

func whFormDesc(wh *store.Webhook) string {
	if wh == nil {
		return ""
	}
	return wh.Description
}

func whFormVerif(wh *store.Webhook) string {
	if wh == nil {
		return "none"
	}
	return wh.VerificationMode
}

func whFormEnabled(wh *store.Webhook) bool {
	if wh == nil {
		return true
	}
	return wh.Enabled
}

func whFormSecretHeader(wh *store.Webhook) string {
	if wh == nil {
		return ""
	}
	return wh.SecretHeader
}

func whFormIsManaged(wh *store.Webhook) bool {
	return wh != nil && wh.ManagedBy != nil && *wh.ManagedBy != ""
}

func whFormManagedLabel(wh *store.Webhook) string {
	if wh == nil || wh.ManagedBy == nil || *wh.ManagedBy == "" {
		return ""
	}
	return plugin.LabelForName(*wh.ManagedBy)
}

func whFormProcessorLabel(wh *store.Webhook, processorTypes []plugin.ProcessorInfo) string {
	if wh == nil || wh.ProcessorType == nil {
		return "None (generic)"
	}
	for _, pt := range processorTypes {
		if pt.Type == *wh.ProcessorType {
			return pt.Label
		}
	}
	return *wh.ProcessorType
}

templ WebhookFormModalContent(wh *store.Webhook, processorTypes []plugin.ProcessorInfo, errMsg string) {
	<div class="box">
		if wh == nil {
			<h2 class="title is-6 mb-4" id="wh-dialog-title">New webhook</h2>
		} else {
			<h2 class="title is-6 mb-4" id="wh-dialog-title">Edit webhook</h2>
		}
		<form
			if wh == nil {
				hx-post="/admin/fragments/triggers/webhook"
			} else {
				hx-patch={ "/admin/fragments/triggers/" + wh.ID }
			}
			hx-target="#trigger-modal"
			x-data={ webhookFormAlpineData(whFormVerif(wh), wh != nil, wh != nil && wh.Secret != "") }
		>
			<div class="columns">
				<div class="column">
					<div class="field">
						<label for="wh-name" class="label is-small">Name</label>
						<div class="control">
							<input
								id="wh-name"
								name="name"
								required
								maxlength="100"
								value={ whFormName(wh) }
								class="input is-small"
							/>
						</div>
					</div>
				</div>
				<div class="column">
					<div class="field">
						<label for="wh-slug" class="label is-small">
							Slug <span class="has-text-weight-normal has-text-grey">(path after /webhook/)</span>
						</label>
						<div class="control">
							<input
								id="wh-slug"
								name="slug"
								required
								placeholder="e.g. my-service/event"
								value={ whFormSlug(wh) }
								disabled?={ wh != nil }
								class="input is-small is-family-monospace"
							/>
						</div>
					</div>
				</div>
			</div>
			<div class="field">
				<label for="wh-desc" class="label is-small">Description</label>
				<div class="control">
					<input
						id="wh-desc"
						name="description"
						maxlength="500"
						value={ whFormDesc(wh) }
						class="input is-small"
					/>
				</div>
			</div>
			<div class="field">
				<label class="is-flex is-align-items-center is-size-6" style="gap: 0.5rem; cursor: pointer">
					<input
						id="wh-enabled"
						type="checkbox"
						name="enabled"
						value="true"
						checked?={ whFormEnabled(wh) }
					/>
					Enabled
				</label>
			</div>
			if whFormIsManaged(wh) {
				<div class="notification is-info mb-4" style="padding: 0.75rem 1rem">
					<p class="is-size-7">This webhook is managed by the { whFormManagedLabel(wh) } plugin — processor type and actions cannot be edited here. Name and slug remain editable.</p>
				</div>
				<div class="field">
					<label class="label is-small">Processor type</label>
					<div class="control">
						<input type="text" value={ whFormProcessorLabel(wh, processorTypes) } class="input is-small" disabled/>
					</div>
				</div>
			} else {
				<div class="field">
					<label for="wh-processor" class="label is-small">Processor type</label>
					<div class="control">
						<div class="select is-small">
							<select id="wh-processor" name="processor_type">
								<option value="" selected?={ wh == nil || wh.ProcessorType == nil }>None (generic)</option>
								for _, pt := range processorTypes {
									<option value={ pt.Type } selected?={ wh != nil && wh.ProcessorType != nil && *wh.ProcessorType == pt.Type }>{ pt.Label }</option>
								}
							</select>
						</div>
					</div>
				</div>
			}
			<div class="field">
				<label for="wh-verif" class="label is-small">Signature verification</label>
				<div class="control">
					<div class="select is-small">
						<select id="wh-verif" name="verification_mode" x-model="verif">
							<option value="none">None</option>
							<option value="header_secret">Header secret (raw comparison)</option>
							<option value="hmac_sha256">HMAC-SHA256 (e.g. GitHub-style)</option>
						</select>
					</div>
				</div>
			</div>
			<div
				x-show="verif !== 'none'"
				class="box mb-4"
				style="background: var(--bulma-light); border: 1px solid var(--bulma-border)"
			>
				<div class="columns">
					<div class="column">
						<div class="field">
							<label for="wh-sig-header" class="label is-small">Signature header</label>
							<div class="control">
								<input
									id="wh-sig-header"
									name="signature_header"
									placeholder="e.g. X-Hub-Signature-256"
									value={ whFormSecretHeader(wh) }
									class="input is-small is-family-monospace"
								/>
							</div>
						</div>
					</div>
					<div class="column">
						<div x-show="isEdit && hasSecret && !clearSecret">
							<div class="field">
								<label class="label is-small">New secret (leave blank to keep existing)</label>
								<div class="field has-addons">
									<div class="control is-expanded">
										<input
											type="password"
											name="secret"
											placeholder="Enter new value to replace…"
											class="input is-small is-family-monospace"
										/>
									</div>
									<div class="control">
										<button
											type="button"
											x-on:click="clearSecret = true"
											class="button is-small is-danger is-outlined"
										>Remove</button>
									</div>
								</div>
							</div>
						</div>
						<div x-show="!(isEdit && hasSecret && !clearSecret)">
							<div class="field">
								<label for="wh-secret-new" class="label is-small">Secret</label>
								<div class="control">
									<input
										id="wh-secret-new"
										type="password"
										name="secret"
										class="input is-small is-family-monospace"
									/>
								</div>
							</div>
						</div>
						<input type="hidden" name="clear_secret" :value="clearSecret ? 'true' : 'false'"/>
					</div>
				</div>
			</div>
			@AlertBox(errMsg, "error")
			<div class="field is-grouped is-grouped-right">
				<div class="control">
					<button
						type="button"
						onclick="document.getElementById('trigger-modal').close()"
						class="button is-small"
					>Cancel</button>
				</div>
				<div class="control">
					<button type="submit" class="button is-primary is-small">
						if wh == nil {
							Create webhook
						} else {
							Save changes
						}
					</button>
				</div>
			</div>
		</form>
	</div>
}
