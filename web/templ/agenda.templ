package admintempl

import (
	"fmt"
	"time"

	"commons/store"
)

// AgendaDay groups one calendar day's occurrences for agenda-style rendering.
type AgendaDay struct {
	DateLabel string // "Mon, Jan 5"
	Today     bool
	Occs      []store.EventOccurrence
}

// GroupByDay buckets occurrences into days in loc, preserving start-time order.
// Days with no occurrences are skipped. Assumes occurrences are sorted by start.
func GroupByDay(occs []store.EventOccurrence, loc *time.Location) []AgendaDay {
	if loc == nil {
		loc = time.UTC
	}
	today := time.Now().In(loc).Format("2006-01-02")
	var days []AgendaDay
	var cur *AgendaDay
	for _, o := range occs {
		local := o.StartTime.In(loc)
		label := local.Format("Mon, Jan 2")
		if cur == nil || cur.DateLabel != label {
			days = append(days, AgendaDay{
				DateLabel: label,
				Today:     local.Format("2006-01-02") == today,
			})
			cur = &days[len(days)-1]
		}
		cur.Occs = append(cur.Occs, o)
	}
	return days
}

// agendaRangeLabel renders e.g. "Nov 12 – Dec 10, 2026" for a paging header.
func agendaRangeLabel(from, to time.Time) string {
	if from.Year() == to.Year() {
		return from.Format("Jan 2") + " – " + to.Format("Jan 2, 2006")
	}
	return from.Format("Jan 2, 2006") + " – " + to.Format("Jan 2, 2006")
}

// agendaChipColor resolves an occurrence's calendar color, defaulting to the
// theme primary.
func agendaChipColor(colors map[string]string, calID string) string {
	if c, ok := colors[calID]; ok && c != "" {
		return c
	}
	return "var(--bulma-primary)"
}

// agendaDayClasses/styles and agendaRowStyle keep attribute values in Go —
// templ elements take exactly one class and one style attribute.
func agendaDayClasses(compact bool) string {
	if compact {
		return "has-text-weight-semibold is-size-6 py-1"
	}
	return "has-text-weight-semibold is-size-6 py-1 has-background-grey-lighter"
}

func agendaDayStyle(compact bool) string {
	if compact {
		return "border-top: 1px solid var(--bulma-border); margin-top: 0.5rem"
	}
	return "position: sticky; top: 0; z-index: 1; padding-left: 0.5rem"
}

func agendaRowStyle(colors map[string]string, ev store.EventOccurrence, clickable bool) string {
	s := "gap: 0.75rem; padding: 0.35rem 0.5rem; border-left: 3px solid " + agendaChipColor(colors, ev.CalendarID) + "; margin: 0.15rem 0"
	if clickable {
		s += "; cursor: pointer"
	}
	return s
}

// AgendaList renders the shared agenda/list view: day headers, one compact row
// per event. Compact mode (dashboard) is tighter with no descriptions; full
// mode (admin, embed) has sticky day headers, descriptions behind a toggle,
// and — when CalID is set on an editable calendar — click-to-edit rows.
templ AgendaList(days []AgendaDay, colors map[string]string, compact bool, calID string, readOnly bool) {
	for _, day := range days {
		<div class={ agendaDayClasses(compact) } style={ agendaDayStyle(compact) }>
			{ day.DateLabel }
			if day.Today {
				<span class="tag is-primary is-small ml-2">Today</span>
			}
		</div>
		for _, ev := range day.Occs {
			{{ clickable := !compact && !readOnly && calID != "" }}
			<div
				class="is-flex is-align-items-start"
				style={ agendaRowStyle(colors, ev, clickable) }
				if clickable {
					hx-get={ fmt.Sprintf("/admin/fragments/calendars/%s/events/%s/form", calID, ev.ID) + agendaOccQuery(ev) }
					hx-target="#event-form-area"
					hx-swap="innerHTML"
				}
			>
				<div class="is-size-7 has-text-grey" style="width: 8.5rem; flex-shrink: 0; padding-top: 0.15rem">
					if ev.AllDay {
						All day
					} else if ev.EndTime != nil {
						{ ev.StartTime.Format("3:04 PM") } – { ev.EndTime.Format("3:04 PM") }
					} else {
						{ ev.StartTime.Format("3:04 PM") }
					}
				</div>
				<div style="min-width: 0">
					<div class="is-size-6">
						<span class="has-text-weight-semibold">{ ev.Title }</span>
						if ev.Location != nil && *ev.Location != "" {
							<span class="is-size-7 has-text-grey"> · { *ev.Location }</span>
						}
					</div>
					if !compact && ev.Description != nil && *ev.Description != "" {
						<details class="is-size-7">
							<summary class="has-text-grey" style="cursor: pointer">Details</summary>
							<p class="mt-1 has-text-grey">{ *ev.Description }</p>
						</details>
					}
				</div>
			</div>
		}
	}
}

// agendaOccQuery returns the occurrence addressing parameter for recurring rows.
func agendaOccQuery(ev store.EventOccurrence) string {
	if !ev.IsRecurring {
		return ""
	}
	return "?occurrence=" + ev.OccurrenceStart.UTC().Format(time.RFC3339)
}

// AgendaSection is the admin calendar page's agenda pane: a 4-week window with
// prev/next paging, swapped in place by HTMX like the month grid.
templ AgendaSection(calID string, start time.Time, days []AgendaDay, colors map[string]string, readOnly bool) {
	<div id="cal-agenda-section">
		<div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
			<button
				hx-get={ fmt.Sprintf("/admin/fragments/calendars/%s/agenda?start=%s", calID, start.AddDate(0, 0, -28).Format("2006-01-02")) }
				hx-target="#cal-agenda-section"
				hx-swap="outerHTML"
				aria-label="Previous 4 weeks"
				class="button is-ghost is-size-4 px-3"
			>‹</button>
			<span class="has-text-weight-semibold">{ agendaRangeLabel(start, start.AddDate(0, 0, 27)) }</span>
			<button
				hx-get={ fmt.Sprintf("/admin/fragments/calendars/%s/agenda?start=%s", calID, start.AddDate(0, 0, 28).Format("2006-01-02")) }
				hx-target="#cal-agenda-section"
				hx-swap="outerHTML"
				aria-label="Next 4 weeks"
				class="button is-ghost is-size-4 px-3"
			>›</button>
		</div>
		if len(days) == 0 {
			<p class="is-size-7 has-text-grey has-text-centered py-4">No events in this period.</p>
		} else {
			@AgendaList(days, colors, false, calID, readOnly)
		}
	</div>
}
