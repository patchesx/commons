package admintempl

templ ResetPasswordPage(token string, errMsg string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Set Password — Portal</title>
			<link rel="stylesheet" href={ templ.URL(AssetURL("bulma.min.css")) }/>
			<link rel="stylesheet" href={ templ.URL(AssetURL("app.css")) }/>
			<script>
				(function(){
					var mq = window.matchMedia('(prefers-color-scheme: dark)');
					function apply(dark) {
						document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
					}
					apply(mq.matches);
					mq.addEventListener('change', function(e){ apply(e.matches); });
				})();
			</script>
		</head>
		<body>
			<section class="section" style="min-height: 100vh; display: flex; align-items: center; justify-content: center">
				<div style="width: 100%; max-width: 22rem">
					<p class="title is-4 has-text-centered mb-5">Portal</p>
					<div class="box">
						<p class="subtitle is-6 mb-4">Set your password</p>
						if errMsg != "" {
							<div class="notification is-danger mb-4" role="alert">
								{ errMsg }
							</div>
						}
						<form method="POST" action="/reset-password">
							<input type="hidden" name="token" value={ token }/>
							<div class="field">
								<label for="password" class="label is-small">New Password</label>
								<div class="control">
									<input
										id="password"
										type="password"
										name="password"
										required
										minlength="8"
										autofocus
										autocomplete="new-password"
										class="input"
									/>
								</div>
							</div>
							<div class="field">
								<label for="confirm" class="label is-small">Confirm Password</label>
								<div class="control">
									<input
										id="confirm"
										type="password"
										name="confirm"
										required
										minlength="8"
										autocomplete="new-password"
										class="input"
									/>
								</div>
							</div>
							<div class="field mt-5">
								<div class="control">
									<button type="submit" class="button is-primary is-fullwidth">Set Password</button>
								</div>
							</div>
						</form>
					</div>
				</div>
			</section>
		</body>
	</html>
}
