package admintempl

// SidebarItem is a single navigation link.
type SidebarItem struct {
	Path       string
	Label      string
	BadgeHXGet string // optional: htmx endpoint for a badge count span
}

// SidebarGroup is a labeled section of nav links. Use Label="" for an ungrouped section.
type SidebarGroup struct {
	Label string
	Items []SidebarItem
}

// SidebarLayout renders the shared page shell with an overlay drawer sidebar.
// The sidebar floats over content at all breakpoints; the top bar is always visible.
// header: rendered at the top of the sidebar (org name, optional back link)
// footer: rendered at the bottom of the sidebar (user info, logout, etc.)
templ SidebarLayout(orgName, currentPath string, groups []SidebarGroup, header, footer templ.Component) {
	<div x-data="{ open: false }">
		<a href="#main-content" class="is-sr-only">Skip to main content</a>
		<!-- Sidebar drawer — fixed overlay at all breakpoints -->
		<aside
			class="menu sidebar-mobile-bar"
			data-theme="dark"
			x-show="open"
			:inert="!open"
			x-on:click.outside="open = false"
			style="position: fixed; left: 0; top: 0; bottom: 0; width: 14rem; z-index: 50; overflow-y: auto; display: flex; flex-direction: column"
		>
			@header
			<nav style="flex: 1; overflow-y: auto; padding: 0.5rem 0" aria-label="Site navigation">
				for _, group := range groups {
					if group.Label != "" {
						<p class="menu-label px-4">{ group.Label }</p>
					}
					<ul class="menu-list">
						for _, item := range group.Items {
							<li>
								<a
									href={ templ.URL(item.Path) }
									x-on:click="open = false"
									class={ sidebarLinkClass(item.Path, currentPath) }
								>
									<span>{ item.Label }</span>
									if item.BadgeHXGet != "" {
										<span
											hx-get={ item.BadgeHXGet }
											hx-trigger="load"
											hx-swap="outerHTML"
										></span>
									}
								</a>
							</li>
						}
					</ul>
				}
			</nav>
			@footer
		</aside>
		<!-- Top bar — sticky, always visible, toggle button at all breakpoints -->
		<nav
			class="navbar sidebar-mobile-bar"
			role="navigation"
			aria-label="Navigation"
			style="position: sticky; top: 0; z-index: 30"
		>
			<div class="navbar-brand">
				<button
					class="navbar-burger has-text-white"
					role="button"
					x-on:click="open = !open"
					:class="{ 'is-active': open }"
					:aria-expanded="open"
					aria-label="Toggle navigation menu"
				>
					<span aria-hidden="true"></span>
					<span aria-hidden="true"></span>
					<span aria-hidden="true"></span>
					<span aria-hidden="true"></span>
				</button>
				<span class="navbar-item has-text-white has-text-weight-semibold">{ orgName }</span>
			</div>
		</nav>
		<!-- Main content — always full width -->
		<div id="main-content">
			{ children... }
		</div>
	</div>
}

func sidebarLinkClass(path, currentPath string) string {
	if path == currentPath {
		return "is-active"
	}
	return ""
}
