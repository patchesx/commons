package admintempl

import (
	"commons/permissions"
	"commons/web"
	"fmt"
)

func appearancePortalName(cfg web.AppearanceConfig) string {
	if cfg.OrgName != "" {
		return cfg.OrgName
	}
	return "Portal"
}

func hasPermission(perms []string, key string) bool {
	for _, p := range perms {
		if p == key {
			return true
		}
	}
	return false
}

func FilteredPortalNavItems(perms []string) []SidebarItem {
	all := []struct {
		path       string
		label      string
		permission string
	}{
		{"/", "Home", ""},
		// {"/resources", "Resources", permissions.ResourcesView},
		// {"/legislation", "Legislation", permissions.LegislationView},
		{"/admin", "Admin Panel", permissions.AdminAccess},
	}
	var visible []SidebarItem
	for _, item := range all {
		if item.permission == "" || hasPermission(perms, item.permission) {
			visible = append(visible, SidebarItem{Path: item.path, Label: item.label})
		}
	}
	return visible
}

templ portalSidebarHeader() {
	<div class="px-4 py-5 has-text-weight-semibold is-size-5" style="border-bottom: 1px solid rgba(255,255,255,.12); flex-shrink: 0">
		{ appearancePortalName(web.AppearanceFromContext(ctx)) }
	</div>
}

templ portalSidebarFooter(displayName string, unreadCount int) {
	<div class="p-4" style="border-top: 1px solid rgba(255,255,255,.12); flex-shrink: 0" x-data="{ notifOpen: false }">
		<div style="position: relative; display: inline-block; margin-bottom: 0.5rem">
			<button
				hx-get="/fragments/notifications"
				hx-target="#notification-panel"
				hx-swap="innerHTML"
				x-on:click="notifOpen = !notifOpen"
				class="button is-ghost is-small has-text-grey-light px-1"
				aria-label="Notifications"
			>
				<svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
				</svg>
				if unreadCount > 0 {
					<span
						class="tag is-danger is-rounded is-size-7"
						style="position: absolute; top: -0.25rem; right: -0.25rem; width: 1rem; height: 1rem; padding: 0; display: flex; align-items: center; justify-content: center; min-width: 0"
					>{ fmt.Sprint(unreadCount) }</span>
				}
			</button>
			<div
				id="notification-panel"
				x-show="notifOpen"
				x-on:click.outside="notifOpen = false"
				style="display:none; position: absolute; bottom: 100%; margin-bottom: 0.5rem; left: 0; width: 20rem; max-height: 24rem; overflow: auto; border-radius: 0.5rem"
				class="box p-0"
			></div>
		</div>
		<p class="is-size-7 mb-2" style="color: rgba(255,255,255,.7); overflow: hidden; text-overflow: ellipsis; white-space: nowrap">{ displayName }</p>
		<button
			hx-post="/logout"
			hx-on:htmx:after-request="window.location.href='/login'"
			x-on:click="open = false"
			class="button is-ghost is-small has-text-grey-light px-0 is-size-7"
		>Log out</button>
	</div>
}

templ PortalLayout(title, currentPath, displayName string, navItems []SidebarItem, unreadCount int) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — { appearancePortalName(web.AppearanceFromContext(ctx)) }</title>
			<link rel="stylesheet" href={ templ.URL(AssetURL("bulma.min.css")) }/>
			<link rel="stylesheet" href={ templ.URL(AssetURL("app.css")) }/>
			<link rel="stylesheet" href={ templ.URL(AssetURL("phosphor-icons.css")) }/>
			<link rel="stylesheet" href={ templ.URL(AssetURL("phosphor-duotone-icons.css")) }/>
			if appearance := web.AppearanceFromContext(ctx); appearance.FaviconURL != "" {
				<link rel="icon" href={ appearance.FaviconURL }/>
			}
			<script>
				(function(){
					var mq = window.matchMedia('(prefers-color-scheme: dark)');
					function apply(dark) {
						document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
					}
					apply(mq.matches);
					mq.addEventListener('change', function(e){ apply(e.matches); });
				})();
			</script>
			<script defer src={ templ.URL(AssetURL("alpine.min.js")) }></script>
			<script src="/.within.website/x/htmx/htmx.js"></script>
		</head>
		<body>
			@SidebarLayout(
				appearancePortalName(web.AppearanceFromContext(ctx)),
				currentPath,
				[]SidebarGroup{{Items: navItems}},
				portalSidebarHeader(),
				portalSidebarFooter(displayName, unreadCount),
			) {
				<main class="p-4">
					{ children... }
				</main>
			}
		</body>
	</html>
}
