package admintempl

import (
	"fmt"
	"strconv"
	"time"

	"commons/store"
)

script openDialog(id string) {
	document.getElementById(id).showModal()
}

script closeDialog(id string) {
	document.getElementById(id).close()
}

type CalGridCell struct {
	Day    int
	DateID string
}

func DerefStr(s *string) string {
	if s == nil {
		return ""
	}
	return *s
}

templ CalendarsPage(calendars []store.Calendar, selectedCal *store.Calendar, year, month int, grid []CalGridCell, events []store.CalendarEvent) {
	@Layout("Calendars", "/admin/calendars") {
		<div>
			<div class="is-flex is-justify-content-space-between is-align-items-center mb-4">
				<h1 class="title is-4 mb-0">Calendars</h1>
			</div>
			@PageHelp() {
				Each calendar works in one of two modes: <strong>manual</strong> (you add and manage events directly using the grid below) or <strong>live feed</strong> (connect an external iCal URL from Google Calendar, Outlook, etc. — events are fetched fresh on each use, not a snapshot). The Subscribe URL under each calendar name is a read-only ICS feed of its manually-added events — subscribe to it from any calendar app.
			}
			<div class="columns">
				<div class="column is-one-third">
					<div class="card">
						<header class="card-header">
							<p class="card-header-title">Calendars</p>
							<div class="card-header-icon">
								<button
									onclick="document.getElementById('create-calendar-dialog').showModal()"
									class="button is-primary is-small"
								>Add Calendar</button>
							</div>
						</header>
						if len(calendars) == 0 {
							<div class="card-content">
								@EmptyState("No calendars yet. Click \"Add Calendar\" to create one.")
							</div>
						} else {
							<div>
								for _, cal := range calendars {
									<div
										class={ "px-4 py-3" + calSelectedRowClass(selectedCal, cal.ID) }
										x-data="{ confirmDelete: false }"
										style="border-top: 1px solid var(--bulma-border)"
									>
										<a href={ templ.URL("/admin/calendars?cal=" + cal.ID) } class="is-block mb-2" style="text-decoration: none; color: inherit">
											<p class="has-text-weight-semibold">{ cal.Name }</p>
											<p class="is-family-monospace is-size-7 has-text-grey">/cal/{ cal.Slug }.ics · { cal.Timezone }</p>
											if cal.IcalURL != nil && *cal.IcalURL != "" {
												<p class="is-size-7 has-text-info mt-1">Live feed</p>
											}
										</a>
										<div :class="{ 'is-flex': !confirmDelete, 'is-hidden': confirmDelete }" class="is-align-items-center" style="gap: 0.5rem">
											<button
												onclick={ openDialog("edit-cal-" + cal.ID) }
												class="button is-small"
											>Edit</button>
											<button
												x-on:click.stop="confirmDelete = true"
												class="button is-small is-danger is-outlined"
											>Delete</button>
										</div>
										<div :class="{ 'is-flex': confirmDelete, 'is-hidden': !confirmDelete }" class="is-align-items-center is-flex-wrap-wrap" style="gap: 0.5rem">
											<span class="is-size-7 has-text-grey">Delete { cal.Name }?</span>
											<button
												hx-delete={ "/admin/fragments/calendars/" + cal.ID }
												hx-swap="none"
												hx-on:htmx:after-request="if(event.detail.successful) window.location.href='/admin/calendars'"
												class="button is-danger is-small"
												aria-label={ "Confirm delete " + cal.Name }
											>Yes, delete</button>
											<button
												x-on:click.stop="confirmDelete = false"
												class="button is-small"
											>Cancel</button>
										</div>
									</div>
								}
							</div>
						}
					</div>
				</div>
				<div class="column">
					if selectedCal != nil {
						<div>
							<div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
								<div>
									<h2 class="subtitle is-5 mb-0">{ selectedCal.Name }</h2>
									<span class="is-family-monospace is-size-7 has-text-grey">/cal/{ selectedCal.Slug }.ics</span>
								</div>
								if selectedCal.IcalURL == nil || *selectedCal.IcalURL == "" {
									<button
										hx-get={ "/admin/fragments/calendars/" + selectedCal.ID + "/event-form" }
										hx-target="#event-form-area"
										hx-swap="innerHTML"
										class="button is-primary is-small"
									>Add event</button>
								}
							</div>
							if selectedCal.IcalURL != nil && *selectedCal.IcalURL != "" {
								<p class="is-size-7 has-text-grey mb-3">
									This calendar uses a live feed — events are read-only. To manage events manually, use Edit &#8594; Import feed &amp; switch to manual. 
									<em>This will prevent the calendar from being updated automatically going forward.</em>
								</p>
							}
							<div id="event-form-area" class="mb-3"></div>
							@CalendarGridSection(selectedCal.ID, year, month, grid, events, calTimezone(selectedCal), selectedCal.IcalURL != nil && *selectedCal.IcalURL != "")
							if (selectedCal.IcalURL == nil || *selectedCal.IcalURL == "") && len(events) == 0 {
								<p class="is-size-7 has-text-grey mt-2 has-text-centered">No events yet — click a day to add one.</p>
							}
						</div>
					} else {
						<div class="is-flex is-align-items-center is-justify-content-center py-6 has-text-grey">
							Select a calendar to view its events.
						</div>
					}
				</div>
			</div>
		</div>
		<!-- Create calendar dialog -->
		<dialog
			id="create-calendar-dialog"
			style="width: 100%; max-width: 28rem; max-height: 90dvh; overflow-y: auto; padding: 0; border: none; border-radius: 0.5rem"
		>
			<div class="box">
				<div class="is-flex is-justify-content-space-between is-align-items-center mb-4">
					<h2 class="title is-6 mb-0">New Calendar</h2>
					<button
						onclick="document.getElementById('create-calendar-dialog').close()"
						class="delete"
						aria-label="Close"
					></button>
				</div>
				@calendarForm("", "", "", "", "", "", "0", "")
			</div>
		</dialog>
		<!-- Per-calendar edit dialogs -->
		for _, cal := range calendars {
			<dialog
				id={ "edit-cal-" + cal.ID }
				style="width: 100%; max-width: 28rem; max-height: 90dvh; overflow-y: auto; padding: 0; border: none; border-radius: 0.5rem"
			>
				<div class="box">
					<div class="is-flex is-justify-content-space-between is-align-items-center mb-4">
						<h2 class="title is-6 mb-0">Edit Calendar</h2>
						<button
							onclick={ closeDialog("edit-cal-" + cal.ID) }
							class="delete"
							aria-label="Close"
						></button>
					</div>
					@calendarForm(cal.ID, cal.Name, cal.Slug, DerefStr(cal.Description), DerefStr(cal.IcalURL), cal.Timezone, strconv.Itoa(cal.DisplayOrder), "")
				</div>
			</dialog>
		}
	}
}

func calSelectedRowClass(selected *store.Calendar, calID string) string {
	if selected != nil && selected.ID == calID {
		return " has-background-primary-light"
	}
	return ""
}

templ calendarForm(calID, name, slug, description, icalURL, timezone, displayOrder string, errMsg string) {
	<form
		if calID == "" {
			hx-post="/admin/fragments/calendars/create"
		} else {
			hx-patch={ "/admin/fragments/calendars/" + calID }
		}
		hx-swap="none"
		hx-on:htmx:after-request="if(event.detail.successful){ const loc=event.detail.xhr.getResponseHeader('HX-Redirect'); if(loc) window.location.href=loc }"
	>
		@AlertBox(errMsg, "error")
		<div class="field mb-3">
			<label for={ "cal-name-" + calID } class="label is-small">Name <span class="has-text-danger" aria-hidden="true">*</span></label>
			<div class="control">
				<input
					id={ "cal-name-" + calID }
					type="text"
					name="name"
					value={ name }
					required
					placeholder="e.g. Chapter Events"
					class="input is-small"
				/>
			</div>
		</div>
		<div class="field mb-3">
			<label for={ "cal-slug-" + calID } class="label is-small">Slug <span class="has-text-danger" aria-hidden="true">*</span></label>
			<div class="control">
				<input
					id={ "cal-slug-" + calID }
					type="text"
					name="slug"
					value={ slug }
					required
					placeholder="e.g. chapter-events"
					pattern="[a-z0-9-]+"
					class="input is-small is-family-monospace"
				/>
			</div>
		</div>
		<div class="field mb-3">
			<label for={ "cal-tz-" + calID } class="label is-small">Timezone <span class="has-text-danger" aria-hidden="true">*</span></label>
			<div class="control">
				<input
					id={ "cal-tz-" + calID }
					type="text"
					name="timezone"
					value={ timezone }
					required
					placeholder="e.g. America/New_York"
					class="input is-small"
				/>
			</div>
			<p class="help has-text-grey">All events — including those from an external iCal feed — are displayed in this timezone.</p>
		</div>
		<div class="field mb-3">
			<label for={ "cal-desc-" + calID } class="label is-small">Description</label>
			<div class="control">
				<input
					id={ "cal-desc-" + calID }
					type="text"
					name="description"
					value={ description }
					placeholder="Optional"
					class="input is-small"
				/>
			</div>
		</div>
		<div class="field mb-3">
			<label for={ "cal-ical-" + calID } class="label is-small">Live iCal Feed URL</label>
			<div class="control">
				<input
					id={ "cal-ical-" + calID }
					type="url"
					name="ical_url"
					value={ icalURL }
					placeholder="https://calendar.google.com/…"
					class="input is-small"
				/>
			</div>
			<p class="help has-text-grey">If set, events are fetched live from this URL each time the calendar is displayed. Leave blank to manage events manually using the grid.</p>
		</div>
		<div class="field mb-4">
			<label for={ "cal-order-" + calID } class="label is-small">Display Order</label>
			<div class="control">
				<input
					id={ "cal-order-" + calID }
					type="number"
					name="display_order"
					value={ displayOrder }
					min="0"
					class="input is-small"
					style="max-width: 6rem"
				/>
			</div>
			<p class="help has-text-grey">Lower numbers appear first in lists and dropdowns. Calendars with the same number are sorted alphabetically.</p>
		</div>
		<button type="submit" class="button is-primary is-small">
			if calID == "" {
				Create
			} else {
				Save
			}
		</button>
	</form>
	if calID != "" && icalURL != "" {
		<div class="mt-4 pt-4" style="border-top: 1px solid var(--bulma-border)">
			<p class="is-size-7 has-text-grey mb-2">Import all events from the live feed into the database and stop using the external URL. You can then manage events manually.</p>
			<button
				hx-post={ "/admin/fragments/calendars/" + calID + "/convert-to-manual" }
				hx-swap="none"
				hx-on:htmx:after-request="if(event.detail.successful){ const loc=event.detail.xhr.getResponseHeader('HX-Redirect'); if(loc) window.location.href=loc }"
				class="button is-small"
			>Import feed &amp; switch to manual</button>
		</div>
	}
}

templ CalendarGridSection(calID string, year, month int, grid []CalGridCell, events []store.CalendarEvent, loc *time.Location, readOnly bool) {
	<div id="cal-grid-section">
		<div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
			<button
				hx-get={ fmt.Sprintf("/admin/fragments/calendars/%s/grid?year=%d&month=%d", calID, prevYear(year, month), prevMonth(month)) }
				hx-target="#cal-grid-section"
				hx-swap="outerHTML"
				aria-label="Previous month"
				class="button is-ghost is-size-4 px-3"
			>‹</button>
			<div x-data="{ picking: false }">
				<button
					x-show="!picking"
					x-on:click="picking = true"
					class="button is-ghost has-text-weight-semibold is-size-6 px-2"
					aria-label="Jump to month"
				>{ monthLabel(year, month) }</button>
				<div x-show="picking" style="display: none">
					<div class="is-flex is-align-items-center" style="gap: 0.5rem">
						<div class="select is-small">
							<select
								name="month"
								id={ "cal-month-" + calID }
								hx-get={ "/admin/fragments/calendars/" + calID + "/grid" }
								hx-target="#cal-grid-section"
								hx-swap="outerHTML"
								hx-include={ "#cal-month-" + calID + ",#cal-year-" + calID }
								hx-trigger="change"
								x-on:change="picking = false"
							>
								for m := 1; m <= 12; m++ {
									<option value={ strconv.Itoa(m) } selected?={ m == month }>{ monthName(m) }</option>
								}
							</select>
						</div>
						<div class="select is-small">
							<select
								name="year"
								id={ "cal-year-" + calID }
								hx-get={ "/admin/fragments/calendars/" + calID + "/grid" }
								hx-target="#cal-grid-section"
								hx-swap="outerHTML"
								hx-include={ "#cal-month-" + calID + ",#cal-year-" + calID }
								hx-trigger="change"
								x-on:change="picking = false"
							>
								for y := year - 2; y <= year + 2; y++ {
									<option value={ strconv.Itoa(y) } selected?={ y == year }>{ strconv.Itoa(y) }</option>
								}
							</select>
						</div>
						<button x-on:click="picking = false" class="button is-small is-ghost" aria-label="Close picker">✕</button>
					</div>
				</div>
			</div>
			<button
				hx-get={ fmt.Sprintf("/admin/fragments/calendars/%s/grid?year=%d&month=%d", calID, nextYear(year, month), nextMonth(month)) }
				hx-target="#cal-grid-section"
				hx-swap="outerHTML"
				aria-label="Next month"
				class="button is-ghost is-size-4 px-3"
			>›</button>
		</div>
		<div style="display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; margin-bottom: 0.25rem">
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Sun</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Mon</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Tue</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Wed</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Thu</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Fri</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Sat</div>
		</div>
		<div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; background: var(--bulma-border); border-radius: 0.375rem; overflow: hidden">
			for _, cell := range grid {
				if cell.Day == 0 {
					<div style="background: var(--bulma-scheme-main-bis); min-height: 2.5rem"></div>
				} else if readOnly {
					<div style="background: var(--bulma-scheme-main); min-height: 2.5rem; padding: 0.25rem">
						<div class="is-size-7 has-text-weight-semibold">{ strconv.Itoa(cell.Day) }</div>
						for _, ev := range eventsOnDate(events, cell.DateID, loc) {
							<div class="is-size-7" style="background: var(--bulma-primary-light); color: var(--bulma-primary-dark); border-radius: 0.25rem; padding: 0 0.25rem; margin-top: 0.125rem; overflow: hidden">{ ev.Title }</div>
						}
					</div>
				} else {
					<div
						style="background: var(--bulma-scheme-main); min-height: 2.5rem; padding: 0.25rem; cursor: pointer"
						hx-get={ fmt.Sprintf("/admin/fragments/calendars/%s/event-form?date=%s", calID, cell.DateID) }
						hx-target="#event-form-area"
						hx-swap="innerHTML"
					>
						<div class="is-size-7 has-text-weight-semibold">{ strconv.Itoa(cell.Day) }</div>
						for _, ev := range eventsOnDate(events, cell.DateID, loc) {
							<div
								class="is-size-7"
								style="background: var(--bulma-primary-light); color: var(--bulma-primary-dark); border-radius: 0.25rem; padding: 0 0.25rem; margin-top: 0.125rem; overflow: hidden; cursor: pointer"
								hx-get={ fmt.Sprintf("/admin/fragments/calendars/%s/events/%s/form", calID, ev.ID) }
								hx-target="#event-form-area"
								hx-swap="innerHTML"
								onclick="event.stopPropagation()"
							>{ ev.Title }</div>
						}
					</div>
				}
			}
		</div>
	</div>
}

templ EventForm(calID string, ev *store.CalendarEvent, errMsg string) {
	<div class="box mb-4">
		<h3 class="title is-6 mb-3">
			if ev != nil && ev.ID != "" {
				Edit Event
			} else {
				New Event
			}
		</h3>
		<form
			if ev != nil && ev.ID != "" {
				hx-patch={ fmt.Sprintf("/admin/fragments/calendars/%s/events/%s", calID, ev.ID) }
			} else {
				hx-post={ fmt.Sprintf("/admin/fragments/calendars/%s/events", calID) }
			}
			hx-target="#event-form-area"
			hx-swap="innerHTML"
		>
			@AlertBox(errMsg, "error")
			<div class="field mb-3">
				<label for="ev-title" class="label is-small">Title <span class="has-text-danger" aria-hidden="true">*</span></label>
				<div class="control">
					<input
						id="ev-title"
						type="text"
						name="title"
						value={ evTitle(ev) }
						required
						class="input is-small"
					/>
				</div>
			</div>
			<div class="columns mb-0">
				<div class="column">
					<div class="field">
						<label for="ev-start" class="label is-small">Start <span class="has-text-danger" aria-hidden="true">*</span></label>
						<div class="control">
							<input
								id="ev-start"
								type="datetime-local"
								name="start_time"
								value={ evStart(ev) }
								required
								class="input is-small"
							/>
						</div>
					</div>
				</div>
				<div class="column">
					<div class="field">
						<label for="ev-end" class="label is-small">End</label>
						<div class="control">
							<input
								id="ev-end"
								type="datetime-local"
								name="end_time"
								value={ evEnd(ev) }
								class="input is-small"
							/>
						</div>
					</div>
				</div>
			</div>
			<div class="field mb-3">
				<label for="ev-desc" class="label is-small">Description</label>
				<div class="control">
					<textarea
						id="ev-desc"
						name="description"
						rows="2"
						class="textarea is-small"
					>
						if ev != nil && ev.Description != nil {
							{ *ev.Description }
						}
					</textarea>
				</div>
			</div>
			<div class="field mb-4">
				<label for="ev-location" class="label is-small">Location</label>
				<div class="control">
					<input
						id="ev-location"
						type="text"
						name="location"
						value={ evLocation(ev) }
						class="input is-small"
					/>
				</div>
			</div>
			<div class="is-flex is-align-items-center" style="gap: 0.5rem">
				<button type="submit" class="button is-primary is-small">
					if ev != nil {
						Save
					} else {
						Add Event
					}
				</button>
				if ev != nil && ev.ID != "" {
					<button
						type="button"
						data-cal-id={ calID }
						hx-delete={ fmt.Sprintf("/admin/fragments/calendars/%s/events/%s", calID, ev.ID) }
						hx-swap="none"
						hx-on:htmx:after-request="if(event.detail.successful){ document.getElementById('event-form-area').innerHTML=''; htmx.ajax('GET', '/admin/fragments/calendars/'+this.dataset.calId+'/grid', {target: '#cal-grid-section', swap: 'outerHTML'}) }"
						class="button is-danger is-small is-outlined"
					>Delete</button>
				}
				<button
					type="button"
					x-on:click="document.getElementById('event-form-area').innerHTML=''"
					class="button is-small is-ghost"
				>Cancel</button>
			</div>
		</form>
	</div>
}

func evTitle(ev *store.CalendarEvent) string {
	if ev == nil {
		return ""
	}
	return ev.Title
}

func evStart(ev *store.CalendarEvent) string {
	if ev == nil {
		return ""
	}
	return ev.StartTime.Format("2006-01-02T15:04")
}

func evEnd(ev *store.CalendarEvent) string {
	if ev == nil || ev.EndTime == nil {
		return ""
	}
	return ev.EndTime.Format("2006-01-02T15:04")
}

func evLocation(ev *store.CalendarEvent) string {
	if ev == nil || ev.Location == nil {
		return ""
	}
	return *ev.Location
}

func calTimezone(cal *store.Calendar) *time.Location {
	if cal == nil {
		return time.UTC
	}
	loc, err := time.LoadLocation(cal.Timezone)
	if err != nil || loc == nil {
		return time.UTC
	}
	return loc
}

func eventsOnDate(events []store.CalendarEvent, dateID string, loc *time.Location) []store.CalendarEvent {
	var result []store.CalendarEvent
	for _, ev := range events {
		if ev.StartTime.In(loc).Format("2006-01-02") == dateID {
			result = append(result, ev)
		}
	}
	return result
}

func monthLabel(year, month int) string {
	t := time.Date(year, time.Month(month), 1, 0, 0, 0, 0, time.UTC)
	return t.Format("January 2006")
}

func monthName(m int) string {
	return time.Month(m).String()
}

func prevMonth(month int) int {
	if month == 1 {
		return 12
	}
	return month - 1
}

func nextMonth(month int) int {
	if month == 12 {
		return 1
	}
	return month + 1
}

func prevYear(year, month int) int {
	if month == 1 {
		return year - 1
	}
	return year
}

func nextYear(year, month int) int {
	if month == 12 {
		return year + 1
	}
	return year
}
