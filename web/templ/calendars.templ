package admintempl

import (
	"fmt"
	"strconv"
	"strings"
	"time"

	"commons/store"
)

script openDialog(id string) {
	document.getElementById(id).showModal()
}

script closeDialog(id string) {
	document.getElementById(id).close()
}

type CalGridCell struct {
	Day    int
	DateID string
}

func DerefStr(s *string) string {
	if s == nil {
		return ""
	}
	return *s
}

// timeAgo renders a coarse human-readable "x ago" for sync status display.
func timeAgo(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		return fmt.Sprintf("%d minutes ago", int(d.Minutes()))
	case d < 24*time.Hour:
		return fmt.Sprintf("%d hours ago", int(d.Hours()))
	default:
		return fmt.Sprintf("%d days ago", int(d.Hours()/24))
	}
}

// viewBtnActive highlights the active view toggle button.
func viewBtnActive(active bool) string {
	if active {
		return " is-info is-selected"
	}
	return ""
}

// calReadOnly reports whether a calendar's events cannot be edited inline:
// live-feed calendars, composites, and personal calendars are read-only views.
func calReadOnly(cal *store.Calendar) bool {
	if cal == nil {
		return false
	}
	if cal.IcalURL != nil && *cal.IcalURL != "" {
		return true
	}
	return cal.Kind == store.CalendarKindComposite || cal.Kind == store.CalendarKindPersonal
}

// calendarFormValues derives form field values from a calendar. cal == nil means
// the create form.
func calendarFormValues(cal *store.Calendar) (calID, name, slug, description, icalURL, timezone, displayOrder, color, kind string) {
	if cal == nil {
		return "", "", "", "", "", "", "0", "", store.CalendarKindStandard
	}
	order := "0"
	if cal.DisplayOrder > 0 {
		order = strconv.Itoa(cal.DisplayOrder)
	}
	return cal.ID, cal.Name, cal.Slug, DerefStr(cal.Description), DerefStr(cal.IcalURL), cal.Timezone, order, DerefStr(cal.Color), cal.Kind
}

// memberCandidates lists calendars selectable as composite members:
// everything except the composite itself and other composites already being edited.
func memberCandidates(all []store.Calendar, selfID string) []store.Calendar {
	var out []store.Calendar
	for _, cal := range all {
		if cal.ID == selfID || cal.Kind == store.CalendarKindPersonal {
			continue
		}
		out = append(out, cal)
	}
	return out
}

func containsString(list []string, s string) bool {
	for _, v := range list {
		if v == s {
			return true
		}
	}
	return false
}

templ CalendarsPage(calendars []store.Calendar, selectedCal *store.Calendar, year, month int, grid []CalGridCell, events []store.EventOccurrence, membersByCal map[string][]string, lastSynced *time.Time, reminders []store.CalendarReminder, view string, agendaDays []AgendaDay, agendaColors map[string]string, agendaStart time.Time, embedBase string) {
	@Layout("Calendars", "/admin/calendars") {
		<div>
			<div class="is-flex is-justify-content-space-between is-align-items-center mb-4">
				<h1 class="title is-4 mb-0">Calendars</h1>
			</div>
			@PageHelp() {
				Each calendar works in one of two modes: <strong>manual</strong> (you add and manage events directly using the grid below) or <strong>live feed</strong> (connect an external iCal URL from Google Calendar, Outlook, etc. — events are fetched fresh on each use, not a snapshot). The Subscribe URL under each calendar name is a read-only ICS feed of its manually-added events — subscribe to it from any calendar app.
			}
			<div class="columns">
				<div class="column is-one-third">
					<div class="card">
						<header class="card-header">
							<p class="card-header-title">Calendars</p>
							<div class="card-header-icon">
								<button
									onclick="document.getElementById('create-calendar-dialog').showModal()"
									class="button is-primary is-small"
								>Add Calendar</button>
							</div>
						</header>
						if len(calendars) == 0 {
							<div class="card-content">
								@EmptyState("No calendars yet. Click \"Add Calendar\" to create one.")
							</div>
						} else {
							<div>
								for _, cal := range calendars {
									<div
										class={ "px-4 py-3" + calSelectedRowClass(selectedCal, cal.ID) }
										x-data="{ confirmDelete: false }"
										style="border-top: 1px solid var(--bulma-border)"
									>
										<a href={ templ.URL("/admin/calendars?cal=" + cal.ID) } class="is-block mb-2" style="text-decoration: none; color: inherit">
											<p class="has-text-weight-semibold">{ cal.Name }</p>
											<p class="is-family-monospace is-size-7 has-text-grey">/cal/{ cal.Slug }.ics · { cal.Timezone }</p>
											if cal.Kind == store.CalendarKindComposite {
												<p class="is-size-7 has-text-primary mt-1">Composite</p>
											} else if cal.IcalURL != nil && *cal.IcalURL != "" {
												<p class="is-size-7 has-text-info mt-1">Live feed</p>
											}
										</a>
										<div :class="{ 'is-flex': !confirmDelete, 'is-hidden': confirmDelete }" class="is-align-items-center" style="gap: 0.5rem">
											<button
												onclick={ openDialog("edit-cal-" + cal.ID) }
												class="button is-small"
											>Edit</button>
											<button
												x-on:click.stop="confirmDelete = true"
												class="button is-small is-danger is-outlined"
											>Delete</button>
										</div>
										<div :class="{ 'is-flex': confirmDelete, 'is-hidden': !confirmDelete }" class="is-align-items-center is-flex-wrap-wrap" style="gap: 0.5rem">
											<span class="is-size-7 has-text-grey">Delete { cal.Name }?</span>
											<button
												hx-delete={ "/admin/fragments/calendars/" + cal.ID }
												hx-swap="none"
												hx-on:htmx:after-request="if(event.detail.successful) window.location.href='/admin/calendars'"
												class="button is-danger is-small"
												aria-label={ "Confirm delete " + cal.Name }
											>Yes, delete</button>
											<button
												x-on:click.stop="confirmDelete = false"
												class="button is-small"
											>Cancel</button>
										</div>
									</div>
								}
							</div>
						}
					</div>
				</div>
				<div class="column">
					if selectedCal != nil {
						<div>
							<div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
								<div>
									<h2 class="subtitle is-5 mb-0">{ selectedCal.Name }</h2>
									<span class="is-family-monospace is-size-7 has-text-grey">/cal/{ selectedCal.Slug }.ics</span>
								</div>
								if !calReadOnly(selectedCal) {
									<button
										hx-get={ "/admin/fragments/calendars/" + selectedCal.ID + "/event-form" }
										hx-target="#event-form-area"
										hx-swap="innerHTML"
										class="button is-primary is-small"
									>Add event</button>
								}
							</div>
							if selectedCal.Kind == store.CalendarKindComposite {
								<p class="is-size-7 has-text-grey mb-3">
									This is a composite calendar — it shows events merged from its member calendars. Events can't be added here; edit them on their source calendar.
								</p>
							} else if selectedCal.IcalURL != nil && *selectedCal.IcalURL != "" {
								<div class="is-size-7 has-text-grey mb-3">
									<p>
										This calendar syncs from a live feed — events are read-only here.
										if lastSynced != nil {
											Last synced { timeAgo(*lastSynced) }.
										} else {
											Not synced yet.
										}
									</p>
									<div class="is-flex is-align-items-center mt-1" style="gap: 0.5rem">
										<button
											hx-post={ "/admin/fragments/calendars/" + selectedCal.ID + "/sync-now" }
											hx-swap="none"
											hx-on:htmx:after-request="if(event.detail.successful){ const loc=event.detail.xhr.getResponseHeader('HX-Redirect'); if(loc) window.location.href=loc }"
											class="button is-small"
										>Sync now</button>
										<span>To manage events manually instead, use Edit &#8594; Import feed &amp; switch to manual.</span>
									</div>
								</div>
							}
							<div id="event-form-area" class="mb-3"></div>
							<div class="buttons has-addons mb-2">
								<a
									href={ templ.URL(fmt.Sprintf("/admin/calendars?cal=%s&year=%d&month=%d&view=month", selectedCal.ID, year, month)) }
									class={ "button is-small" + viewBtnActive(view == "month") }
								>Month</a>
								<a
									href={ templ.URL(fmt.Sprintf("/admin/calendars?cal=%s&view=agenda", selectedCal.ID)) }
									class={ "button is-small" + viewBtnActive(view == "agenda") }
								>Agenda</a>
							</div>
							if view == "agenda" {
								@AgendaSection(selectedCal.ID, agendaStart, agendaDays, agendaColors, calReadOnly(selectedCal))
							} else {
								@CalendarGridSection(selectedCal.ID, year, month, grid, events, calTimezone(selectedCal), calReadOnly(selectedCal))
							}
							if view != "agenda" && !calReadOnly(selectedCal) && len(events) == 0 {
								<p class="is-size-7 has-text-grey mt-2 has-text-centered">No events yet — click a day to add one.</p>
							}
							if selectedCal.Kind != store.CalendarKindPersonal {
								<div class="card mt-4">
									<header class="card-header">
										<p class="card-header-title is-size-6">Reminders</p>
									</header>
									<div class="card-content">
										<p class="is-size-7 has-text-grey mb-2">
											Post upcoming events from this calendar to Slack channels ahead of their start time. Composites notify for their members' events — duplicate coverage on the same channel is collapsed automatically.
										</p>
										@CalendarRemindersPanel(selectedCal.ID, reminders)
									</div>
								</div>
							}
							if selectedCal.Slug != "" {
								<div class="card mt-4">
									<header class="card-header">
										<p class="card-header-title is-size-6">Embed</p>
									</header>
									<div class="card-content">
										<p class="is-size-7 has-text-grey mb-2">
											Add this calendar to any website with an iframe. Builds from the public embed page — the same visibility as the ICS feed.
										</p>
										@EmbedBuilderPanel(selectedCal.Slug, selectedCal.Name, embedBase)
									</div>
								</div>
							}
						</div>
					} else {
						<div class="is-flex is-align-items-center is-justify-content-center py-6 has-text-grey">
							Select a calendar to view its events.
						</div>
					}
				</div>
			</div>
		</div>
		<!-- Create calendar dialog -->
		<dialog
			id="create-calendar-dialog"
			style="width: 100%; max-width: 28rem; max-height: 90dvh; overflow-y: auto; padding: 0; border: none; border-radius: 0.5rem"
		>
			<div class="box">
				<div class="is-flex is-justify-content-space-between is-align-items-center mb-4">
					<h2 class="title is-6 mb-0">New Calendar</h2>
					<button
						onclick="document.getElementById('create-calendar-dialog').close()"
						class="delete"
						aria-label="Close"
					></button>
				</div>
				@calendarForm(nil, calendars, nil, "")
			</div>
		</dialog>
		<!-- Per-calendar edit dialogs -->
		for _, cal := range calendars {
			<dialog
				id={ "edit-cal-" + cal.ID }
				style="width: 100%; max-width: 28rem; max-height: 90dvh; overflow-y: auto; padding: 0; border: none; border-radius: 0.5rem"
			>
				<div class="box">
					<div class="is-flex is-justify-content-space-between is-align-items-center mb-4">
						<h2 class="title is-6 mb-0">Edit Calendar</h2>
						<button
							onclick={ closeDialog("edit-cal-" + cal.ID) }
							class="delete"
							aria-label="Close"
						></button>
					</div>
					@calendarForm(&cal, calendars, membersByCal[cal.ID], "")
				</div>
			</dialog>
		}
	}
}

func calSelectedRowClass(selected *store.Calendar, calID string) string {
	if selected != nil && selected.ID == calID {
		return " has-background-primary-light"
	}
	return ""
}

templ calendarForm(cal *store.Calendar, allCalendars []store.Calendar, memberIDs []string, errMsg string) {
	{{ calID, name, slug, description, icalURL, timezone, displayOrder, color, kind := calendarFormValues(cal) }}
	<form
		if calID == "" {
			hx-post="/admin/fragments/calendars/create"
		} else {
			hx-patch={ "/admin/fragments/calendars/" + calID }
		}
		hx-swap="none"
		hx-on:htmx:after-request="if(event.detail.successful){ const loc=event.detail.xhr.getResponseHeader('HX-Redirect'); if(loc) window.location.href=loc }"
		x-data={ "{ kind: '" + kind + "' }" }
	>
		@AlertBox(errMsg, "error")
		if cal == nil {
			<div class="field mb-3">
				<label for={ "cal-kind-" + calID } class="label is-small">Type</label>
				<div class="control">
					<div class="select is-small" style="width: 100%">
						<select id={ "cal-kind-" + calID } name="kind" x-model="kind">
							<option value="standard">Standard — manual events or a live iCal feed</option>
							<option value="composite">Composite — merge multiple calendars into one</option>
						</select>
					</div>
				</div>
			</div>
		} else {
			<input type="hidden" name="kind" value={ kind }/>
		}
		<div class="field mb-3">
			<label for={ "cal-name-" + calID } class="label is-small">Name <span class="has-text-danger" aria-hidden="true">*</span></label>
			<div class="control">
				<input
					id={ "cal-name-" + calID }
					type="text"
					name="name"
					value={ name }
					required
					placeholder="e.g. Chapter Events"
					class="input is-small"
				/>
			</div>
		</div>
		<div class="field mb-3">
			<label for={ "cal-slug-" + calID } class="label is-small">Slug <span class="has-text-danger" aria-hidden="true">*</span></label>
			<div class="control">
				<input
					id={ "cal-slug-" + calID }
					type="text"
					name="slug"
					value={ slug }
					required
					placeholder="e.g. chapter-events"
					pattern="[a-z0-9-]+"
					class="input is-small is-family-monospace"
				/>
			</div>
		</div>
		<div class="field mb-3">
			<label for={ "cal-tz-" + calID } class="label is-small">Timezone <span class="has-text-danger" aria-hidden="true">*</span></label>
			<div class="control">
				<input
					id={ "cal-tz-" + calID }
					type="text"
					name="timezone"
					value={ timezone }
					required
					placeholder="e.g. America/New_York"
					class="input is-small"
				/>
			</div>
			<p class="help has-text-grey">All events — including those from member calendars or an external iCal feed — are displayed in this timezone.</p>
		</div>
		<div class="field mb-3">
			<label for={ "cal-desc-" + calID } class="label is-small">Description</label>
			<div class="control">
				<input
					id={ "cal-desc-" + calID }
					type="text"
					name="description"
					value={ description }
					placeholder="Optional"
					class="input is-small"
				/>
			</div>
		</div>
		<div x-show="kind === 'standard'">
			<div class="field mb-3">
				<label for={ "cal-ical-" + calID } class="label is-small">Live iCal Feed URL</label>
				<div class="control">
					<input
						id={ "cal-ical-" + calID }
						type="url"
						name="ical_url"
						value={ icalURL }
						placeholder="https://calendar.google.com/…"
						class="input is-small"
					/>
				</div>
				<p class="help has-text-grey">If set, events are fetched live from this URL each time the calendar is displayed. Leave blank to manage events manually using the grid.</p>
			</div>
		</div>
		<div x-show="kind === 'composite'">
			<div class="field mb-3">
				<label class="label is-small">Member Calendars <span class="has-text-danger" aria-hidden="true">*</span></label>
				<div class="control">
					for _, cand := range memberCandidates(allCalendars, calID) {
						<label class="is-block" style="line-height: 1.9">
							<input
								type="checkbox"
								name="members"
								value={ cand.ID }
								checked?={ containsString(memberIDs, cand.ID) }
							/>
							{ cand.Name }
						</label>
					}
				</div>
				<p class="help has-text-grey">Events from the selected calendars are merged into one view. Identical events (same title and time) are collapsed automatically.</p>
			</div>
		</div>
		<div class="field mb-3">
			<label for={ "cal-color-" + calID } class="label is-small">Color</label>
			<div class="control">
				<input
					id={ "cal-color-" + calID }
					type="text"
					name="color"
					value={ color }
					placeholder="#3273dc"
					pattern="^#[0-9a-fA-F]{6}$"
					class="input is-small is-family-monospace"
					style="max-width: 7rem"
				/>
			</div>
			<p class="help has-text-grey">Optional hex color for event chips in list views.</p>
		</div>
		<div class="field mb-4">
			<label for={ "cal-order-" + calID } class="label is-small">Display Order</label>
			<div class="control">
				<input
					id={ "cal-order-" + calID }
					type="number"
					name="display_order"
					value={ displayOrder }
					min="0"
					class="input is-small"
					style="max-width: 6rem"
				/>
			</div>
			<p class="help has-text-grey">Lower numbers appear first in lists and dropdowns. Calendars with the same number are sorted alphabetically.</p>
		</div>
		<button type="submit" class="button is-primary is-small">
			if calID == "" {
				Create
			} else {
				Save
			}
		</button>
	</form>
	if calID != "" && kind == store.CalendarKindStandard && icalURL != "" {
		<div class="mt-4 pt-4" style="border-top: 1px solid var(--bulma-border)">
			<p class="is-size-7 has-text-grey mb-2">Import all events from the live feed into the database and stop using the external URL. You can then manage events manually.</p>
			<button
				hx-post={ "/admin/fragments/calendars/" + calID + "/convert-to-manual" }
				hx-swap="none"
				hx-on:htmx:after-request="if(event.detail.successful){ const loc=event.detail.xhr.getResponseHeader('HX-Redirect'); if(loc) window.location.href=loc }"
				class="button is-small"
			>Import feed &amp; switch to manual</button>
		</div>
	}
}

templ CalendarGridSection(calID string, year, month int, grid []CalGridCell, events []store.EventOccurrence, loc *time.Location, readOnly bool) {
	<div id="cal-grid-section">
		<div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
			<button
				hx-get={ fmt.Sprintf("/admin/fragments/calendars/%s/grid?year=%d&month=%d", calID, prevYear(year, month), prevMonth(month)) }
				hx-target="#cal-grid-section"
				hx-swap="outerHTML"
				aria-label="Previous month"
				class="button is-ghost is-size-4 px-3"
			>‹</button>
			<div x-data="{ picking: false }">
				<button
					x-show="!picking"
					x-on:click="picking = true"
					class="button is-ghost has-text-weight-semibold is-size-6 px-2"
					aria-label="Jump to month"
				>{ monthLabel(year, month) }</button>
				<div x-show="picking" style="display: none">
					<div class="is-flex is-align-items-center" style="gap: 0.5rem">
						<div class="select is-small">
							<select
								name="month"
								id={ "cal-month-" + calID }
								hx-get={ "/admin/fragments/calendars/" + calID + "/grid" }
								hx-target="#cal-grid-section"
								hx-swap="outerHTML"
								hx-include={ "#cal-month-" + calID + ",#cal-year-" + calID }
								hx-trigger="change"
								x-on:change="picking = false"
							>
								for m := 1; m <= 12; m++ {
									<option value={ strconv.Itoa(m) } selected?={ m == month }>{ monthName(m) }</option>
								}
							</select>
						</div>
						<div class="select is-small">
							<select
								name="year"
								id={ "cal-year-" + calID }
								hx-get={ "/admin/fragments/calendars/" + calID + "/grid" }
								hx-target="#cal-grid-section"
								hx-swap="outerHTML"
								hx-include={ "#cal-month-" + calID + ",#cal-year-" + calID }
								hx-trigger="change"
								x-on:change="picking = false"
							>
								for y := year - 2; y <= year + 2; y++ {
									<option value={ strconv.Itoa(y) } selected?={ y == year }>{ strconv.Itoa(y) }</option>
								}
							</select>
						</div>
						<button x-on:click="picking = false" class="button is-small is-ghost" aria-label="Close picker">✕</button>
					</div>
				</div>
			</div>
			<button
				hx-get={ fmt.Sprintf("/admin/fragments/calendars/%s/grid?year=%d&month=%d", calID, nextYear(year, month), nextMonth(month)) }
				hx-target="#cal-grid-section"
				hx-swap="outerHTML"
				aria-label="Next month"
				class="button is-ghost is-size-4 px-3"
			>›</button>
		</div>
		<div style="display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; margin-bottom: 0.25rem">
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Sun</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Mon</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Tue</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Wed</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Thu</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Fri</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Sat</div>
		</div>
		<div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; background: var(--bulma-border); border-radius: 0.375rem; overflow: hidden">
			for _, cell := range grid {
				if cell.Day == 0 {
					<div style="background: var(--bulma-scheme-main-bis); min-height: 2.5rem"></div>
				} else if readOnly {
					<div style="background: var(--bulma-scheme-main); min-height: 2.5rem; padding: 0.25rem">
						<div class="is-size-7 has-text-weight-semibold">{ strconv.Itoa(cell.Day) }</div>
						for _, ev := range eventsOnDate(events, cell.DateID, loc) {
							<div class="is-size-7" style="background: var(--bulma-primary-light); color: var(--bulma-primary-dark); border-radius: 0.25rem; padding: 0 0.25rem; margin-top: 0.125rem; overflow: hidden">{ ev.Title }</div>
						}
					</div>
				} else {
					<div
						style="background: var(--bulma-scheme-main); min-height: 2.5rem; padding: 0.25rem; cursor: pointer"
						hx-get={ fmt.Sprintf("/admin/fragments/calendars/%s/event-form?date=%s", calID, cell.DateID) }
						hx-target="#event-form-area"
						hx-swap="innerHTML"
					>
						<div class="is-size-7 has-text-weight-semibold">{ strconv.Itoa(cell.Day) }</div>
						for _, ev := range eventsOnDate(events, cell.DateID, loc) {
							<div
								class="is-size-7"
								style="background: var(--bulma-primary-light); color: var(--bulma-primary-dark); border-radius: 0.25rem; padding: 0 0.25rem; margin-top: 0.125rem; overflow: hidden; cursor: pointer"
								hx-get={ fmt.Sprintf("/admin/fragments/calendars/%s/events/%s/form", calID, ev.ID) + occQuery(ev) }
								hx-target="#event-form-area"
								hx-swap="innerHTML"
								onclick="event.stopPropagation()"
							>{ ev.Title }</div>
						}
					</div>
				}
			}
		</div>
	</div>
}

// EventFormView carries everything the event form needs: prefilled effective
// values, recurrence editor state, and occurrence addressing for series edits.
// reminderRow is one editable reminder row in the panel.
type reminderRow struct {
	ChannelID   string
	LeadMinutes int
}

templ CalendarRemindersPanel(calID string, reminders []store.CalendarReminder) {
	{{ rows := make([]reminderRow, 0, len(reminders)+1)
	   for _, r := range reminders {
		rows = append(rows, reminderRow{ChannelID: r.ChannelID, LeadMinutes: r.LeadMinutes})
	   }
	   if len(rows) == 0 {
		rows = append(rows, reminderRow{LeadMinutes: 60})
	   } }}
	<div
		x-data={ fmt.Sprintf(`{
			rows: %s,
			channels: [],
			loadingChannels: true,
			addRow() { this.rows.push({ channel_id: '', lead_minutes: 60 }) },
			removeRow(i) { this.rows.splice(i, 1) },
			async loadChannels() {
				try { const r = await fetch('/api/slack/channels'); if (r.ok) this.channels = await r.json(); } finally { this.loadingChannels = false }
			}
		}`, reminderRowsJSON(rows)) }
		x-init="loadChannels()"
	>
		<form
			hx-post={ "/admin/fragments/calendars/" + calID + "/reminders" }
			hx-swap="none"
			hx-on:htmx:after-request="if(event.detail.successful){ const loc=event.detail.xhr.getResponseHeader('HX-Redirect'); if(loc) window.location.href=loc }"
		>
			<template x-for="(row, i) in rows" :key="i">
				<div class="is-flex is-align-items-center mb-2" style="gap: 0.5rem">
					<input type="hidden" :name="'channel_id_' + i" :value="row.channel_id"/>
					<input type="hidden" :name="'lead_minutes_' + i" :value="row.lead_minutes"/>
					<template x-if="loadingChannels">
						<span class="is-size-7 has-text-grey">Loading channels…</span>
					</template>
					<template x-if="!loadingChannels">
						<div class="select is-small" style="flex: 1">
							<select x-model="row.channel_id">
								<option value="">— Select a channel —</option>
								<template x-for="ch in channels" :key="ch.id">
									<option :value="ch.id" :selected="ch.id === row.channel_id" x-text="'#' + ch.name"></option>
								</template>
							</select>
						</div>
					</template>
					<div class="is-flex is-align-items-center" style="gap: 0.25rem">
						<input
							type="number"
							min="1"
							x-model.number="row.lead_minutes"
							class="input is-small"
							style="width: 5rem"
							aria-label="Lead minutes"
						/>
						<span class="is-size-7 has-text-grey">min before</span>
					</div>
					<button type="button" class="button is-small is-danger is-outlined" @click="removeRow(i)" aria-label="Remove reminder">&times;</button>
				</div>
			</template>
			<div class="is-flex is-align-items-center" style="gap: 0.5rem">
				<button type="button" class="button is-small" @click="addRow()">Add channel</button>
				<button type="submit" class="button is-primary is-small">Save</button>
				<span class="is-size-7 has-text-grey">Default 60 minutes.</span>
			</div>
		</form>
	</div>
}

// reminderRowsJSON serializes rows for Alpine's x-data initializer.
func reminderRowsJSON(rows []reminderRow) string {
	var sb strings.Builder
	sb.WriteByte('[')
	for i, r := range rows {
		if i > 0 {
			sb.WriteByte(',')
		}
		fmt.Fprintf(&sb, `{"channel_id":%q,"lead_minutes":%d}`, r.ChannelID, r.LeadMinutes)
	}
	sb.WriteByte(']')
	return sb.String()
}

type EventFormView struct {
	CalendarID string
	EventID    string
	// Occurrence is the RFC3339 address of the series occurrence being edited
	// ("" for standalone events and new events).
	Occurrence  string
	IsRecurring bool
	Ev          *store.CalendarEvent
	Recurrence  store.RecurrenceState
	ErrMsg      string
}

templ EventForm(v EventFormView) {
	<div class="box mb-4">
		<h3 class="title is-6 mb-3">
			if v.EventID != "" {
				Edit Event
			} else {
				New Event
			}
		</h3>
		{{ recShow := "scope === 'all'"
		   if !v.IsRecurring {
			recShow = "true"
		   } }}
		<form
			if v.EventID != "" {
				hx-patch={ fmt.Sprintf("/admin/fragments/calendars/%s/events/%s", v.CalendarID, v.EventID) }
			} else {
				hx-post={ fmt.Sprintf("/admin/fragments/calendars/%s/events", v.CalendarID) }
			}
			hx-target="#event-form-area"
			hx-swap="innerHTML"
			x-data={ "{ repeat: '" + v.Recurrence.Freq + "', end: '" + v.Recurrence.End + "', monthlyMode: '" + v.Recurrence.MonthlyMode + "', scope: 'one' }" }
		>
			@AlertBox(v.ErrMsg, "error")
			if v.Occurrence != "" {
				<input type="hidden" name="occurrence" value={ v.Occurrence }/>
			}
			<div class="field mb-3">
				<label for="ev-title" class="label is-small">Title <span class="has-text-danger" aria-hidden="true">*</span></label>
				<div class="control">
					<input
						id="ev-title"
						type="text"
						name="title"
						value={ evTitle(v.Ev) }
						required
						class="input is-small"
					/>
				</div>
			</div>
			<div class="columns mb-0">
				<div class="column">
					<div class="field">
						<label for="ev-start" class="label is-small">Start <span class="has-text-danger" aria-hidden="true">*</span></label>
						<div class="control">
							<input
								id="ev-start"
								type="datetime-local"
								name="start_time"
								value={ evStart(v.Ev) }
								required
								class="input is-small"
							/>
						</div>
					</div>
				</div>
				<div class="column">
					<div class="field">
						<label for="ev-end" class="label is-small">End</label>
						<div class="control">
							<input
								id="ev-end"
								type="datetime-local"
								name="end_time"
								value={ evEnd(v.Ev) }
								class="input is-small"
							/>
						</div>
					</div>
				</div>
			</div>
			<div class="field mb-3">
				<label for="ev-desc" class="label is-small">Description</label>
				<div class="control">
					<textarea
						id="ev-desc"
						name="description"
						rows="2"
						class="textarea is-small"
					>
						if v.Ev != nil && v.Ev.Description != nil {
							{ *v.Ev.Description }
						}
					</textarea>
				</div>
			</div>
			<div class="field mb-3">
				<label for="ev-location" class="label is-small">Location</label>
				<div class="control">
					<input
						id="ev-location"
						type="text"
						name="location"
						value={ evLocation(v.Ev) }
						class="input is-small"
					/>
				</div>
			</div>
			if v.IsRecurring {
				<div class="field mb-3">
					<label class="label is-small">Applies to</label>
					<div class="control">
						<label class="radio is-block" style="line-height: 1.9">
							<input type="radio" name="scope" value="one" x-model="scope"/>
							This event
						</label>
						<label class="radio is-block" style="line-height: 1.9">
							<input type="radio" name="scope" value="following" x-model="scope"/>
							This and following events
						</label>
						<label class="radio is-block" style="line-height: 1.9">
							<input type="radio" name="scope" value="all" x-model="scope"/>
							All events (changes the repeat rule)
						</label>
					</div>
					<p class="help has-text-grey">"This event" and "this and following" keep the repeat rule; only "all events" can change it.</p>
				</div>
			}
			<div x-show={ recShow } style="display: none">
				<div class="field mb-2">
					<label for="ev-repeat" class="label is-small">Repeat</label>
					<div class="select is-small">
						<select id="ev-repeat" name="repeat" x-model="repeat">
							<option value="none">Does not repeat</option>
							<option value="daily">Daily</option>
							<option value="weekly">Weekly</option>
							<option value="monthly">Monthly</option>
							<option value="yearly">Yearly</option>
						</select>
					</div>
				</div>
				<div x-show="repeat !== 'none'" style="display: none">
					<div class="is-flex is-align-items-center mb-2" style="gap: 0.5rem">
						<span class="is-size-7">Every</span>
						<input
							type="number"
							name="interval"
							min="1"
							value={ strconv.Itoa(recInterval(v.Recurrence)) }
							class="input is-small"
							style="width: 4.5rem"
						/>
						<span class="is-size-7" x-text="repeat === 'daily' ? 'day(s)' : repeat === 'weekly' ? 'week(s)' : repeat === 'monthly' ? 'month(s)' : 'year(s)'"></span>
					</div>
					<div class="field mb-2" x-show="repeat === 'weekly'">
						<span class="is-size-7 has-text-weight-semibold">On days</span>
						<div class="is-flex" style="gap: 0.5rem; flex-wrap: wrap; margin-top: 0.25rem">
							for _, wd := range []string{"MO", "TU", "WE", "TH", "FR", "SA", "SU"} {
								<label class="is-size-7" style="line-height: 1.9">
									<input
										type="checkbox"
										name="byday"
										value={ wd }
										checked?={ containsString(v.Recurrence.ByDay, wd) }
									/>
									{ weekdayShortLabel(wd) }
								</label>
							}
						</div>
					</div>
					<div class="field mb-2" x-show="repeat === 'monthly'">
						<span class="is-size-7 has-text-weight-semibold">Monthly</span>
						<div class="control" style="margin-top: 0.25rem">
							<label class="radio is-size-7 is-block" style="line-height: 1.9">
								<input type="radio" name="monthly_mode" value="day" x-model="monthlyMode"/>
								On day
								<input
									type="number"
									name="bymonthday"
									min="1"
									max="31"
									value={ strconv.Itoa(recByMonthDay(v.Recurrence, v.Ev)) }
									class="input is-small"
									style="width: 4.5rem"
									x-show="monthlyMode === 'day'"
								/>
							</label>
							<label class="radio is-size-7 is-block" style="line-height: 1.9">
								<input type="radio" name="monthly_mode" value="nth" x-model="monthlyMode"/>
								On the
								<span x-show="monthlyMode === 'nth'" style="display: none" class="is-inline-flex" >
									<span class="select is-small">
										<select name="nth">
											<option value="1" selected?={ v.Recurrence.Nth == 1 }>1st</option>
											<option value="2" selected?={ v.Recurrence.Nth == 2 }>2nd</option>
											<option value="3" selected?={ v.Recurrence.Nth == 3 }>3rd</option>
											<option value="4" selected?={ v.Recurrence.Nth == 4 }>4th</option>
											<option value="5" selected?={ v.Recurrence.Nth == 5 }>5th</option>
										</select>
									</span>
									<span class="select is-small">
										<select name="nth_weekday">
											for _, wd := range []string{"MO", "TU", "WE", "TH", "FR", "SA", "SU"} {
												<option value={ wd } selected?={ v.Recurrence.NthWeekday == wd }>{ weekdayShortLabel(wd) }</option>
											}
										</select>
									</span>
								</span>
								<span x-show="monthlyMode !== 'nth'">…</span>
							</label>
						</div>
					</div>
					<div class="field mb-3">
						<span class="is-size-7 has-text-weight-semibold">Ends</span>
						<div class="is-flex is-align-items-center" style="gap: 0.5rem; flex-wrap: wrap; margin-top: 0.25rem">
							<div class="select is-small">
								<select name="end" x-model="end">
									<option value="never">Never</option>
									<option value="until">On date</option>
									<option value="count">After</option>
								</select>
							</div>
							<input
								type="date"
								name="until"
								value={ v.Recurrence.Until }
								class="input is-small"
								style="width: 10rem"
								x-show="end === 'until'"
							/>
							<span x-show="end === 'count'" style="display: none" class="is-inline-flex is-align-items-center" >
								<input
									type="number"
									name="count"
									min="1"
									value={ strconv.Itoa(recCount(v.Recurrence)) }
									class="input is-small"
									style="width: 4.5rem"
								/>
								<span class="is-size-7">occurrences</span>
							</span>
						</div>
					</div>
				</div>
			</div>
			<div class="is-flex is-align-items-center" style="gap: 0.5rem">
				<button type="submit" class="button is-primary is-small">
					if v.EventID != "" {
						Save
					} else {
						Add Event
					}
				</button>
				<button
					type="button"
					x-on:click="document.getElementById('event-form-area').innerHTML=''"
					class="button is-small is-ghost"
				>Cancel</button>
			</div>
		</form>
		if v.EventID != "" {
			<div class="mt-3 pt-3" style="border-top: 1px solid var(--bulma-border)">
				<div class="is-flex is-align-items-center is-flex-wrap-wrap" style="gap: 0.5rem">
					<button
						type="button"
						data-cal-id={ v.CalendarID }
						hx-delete={ fmt.Sprintf("/admin/fragments/calendars/%s/events/%s", v.CalendarID, v.EventID) + deleteParams(v, "one") }
						hx-swap="none"
						hx-on:htmx:after-request="if(event.detail.successful){ document.getElementById('event-form-area').innerHTML=''; htmx.ajax('GET', '/admin/fragments/calendars/'+this.dataset.calId+'/grid', {target: '#cal-grid-section', swap: 'outerHTML'}) }"
						class="button is-danger is-small is-outlined"
					>
						if v.IsRecurring {
							Delete this event
						} else {
							Delete
						}
					</button>
					if v.IsRecurring {
						<button
							type="button"
							data-cal-id={ v.CalendarID }
							hx-delete={ fmt.Sprintf("/admin/fragments/calendars/%s/events/%s", v.CalendarID, v.EventID) + deleteParams(v, "following") }
							hx-swap="none"
							hx-on:htmx:after-request="if(event.detail.successful){ document.getElementById('event-form-area').innerHTML=''; htmx.ajax('GET', '/admin/fragments/calendars/'+this.dataset.calId+'/grid', {target: '#cal-grid-section', swap: 'outerHTML'}) }"
							class="button is-danger is-small is-outlined"
						>Delete this and following</button>
						<button
							type="button"
							data-cal-id={ v.CalendarID }
							hx-delete={ fmt.Sprintf("/admin/fragments/calendars/%s/events/%s", v.CalendarID, v.EventID) + deleteParams(v, "all") }
							hx-swap="none"
							hx-on:htmx:after-request="if(event.detail.successful){ document.getElementById('event-form-area').innerHTML=''; htmx.ajax('GET', '/admin/fragments/calendars/'+this.dataset.calId+'/grid', {target: '#cal-grid-section', swap: 'outerHTML'}) }"
							class="button is-danger is-small"
						>Delete all events</button>
					}
				</div>
			</div>
		}
	</div>
}

// deleteParams builds the query string carrying delete scope and occurrence.
func deleteParams(v EventFormView, scope string) string {
	if !v.IsRecurring {
		return ""
	}
	p := "?scope=" + scope
	if v.Occurrence != "" {
		p += "&occurrence=" + v.Occurrence
	}
	return p
}

func weekdayShortLabel(code string) string {
	return map[string]string{
		"MO": "Mon", "TU": "Tue", "WE": "Wed", "TH": "Thu", "FR": "Fri", "SA": "Sat", "SU": "Sun",
	}[code]
}

func recInterval(st store.RecurrenceState) int {
	if st.Interval < 1 {
		return 1
	}
	return st.Interval
}

func recByMonthDay(st store.RecurrenceState, ev *store.CalendarEvent) int {
	if st.ByMonthDay > 0 {
		return st.ByMonthDay
	}
	if ev != nil {
		return ev.StartTime.Day()
	}
	return 1
}

func recCount(st store.RecurrenceState) int {
	if st.Count > 0 {
		return st.Count
	}
	return 5
}

func evTitle(ev *store.CalendarEvent) string {
	if ev == nil {
		return ""
	}
	return ev.Title
}

func evStart(ev *store.CalendarEvent) string {
	if ev == nil {
		return ""
	}
	return ev.StartTime.Format("2006-01-02T15:04")
}

func evEnd(ev *store.CalendarEvent) string {
	if ev == nil || ev.EndTime == nil {
		return ""
	}
	return ev.EndTime.Format("2006-01-02T15:04")
}

func evLocation(ev *store.CalendarEvent) string {
	if ev == nil || ev.Location == nil {
		return ""
	}
	return *ev.Location
}

func calTimezone(cal *store.Calendar) *time.Location {
	if cal == nil {
		return time.UTC
	}
	loc, err := time.LoadLocation(cal.Timezone)
	if err != nil || loc == nil {
		return time.UTC
	}
	return loc
}

func eventsOnDate(events []store.EventOccurrence, dateID string, loc *time.Location) []store.EventOccurrence {
	var result []store.EventOccurrence
	for _, ev := range events {
		if ev.StartTime.In(loc).Format("2006-01-02") == dateID {
			result = append(result, ev)
		}
	}
	return result
}

// occQuery returns the occurrence addressing parameter for a recurring chip.
func occQuery(ev store.EventOccurrence) string {
	if !ev.IsRecurring {
		return ""
	}
	return "?occurrence=" + ev.OccurrenceStart.UTC().Format(time.RFC3339)
}

func monthLabel(year, month int) string {
	t := time.Date(year, time.Month(month), 1, 0, 0, 0, 0, time.UTC)
	return t.Format("January 2006")
}

func monthName(m int) string {
	return time.Month(m).String()
}

func prevMonth(month int) int {
	if month == 1 {
		return 12
	}
	return month - 1
}

func nextMonth(month int) int {
	if month == 12 {
		return 1
	}
	return month + 1
}

func prevYear(year, month int) int {
	if month == 1 {
		return year - 1
	}
	return year
}

func nextYear(year, month int) int {
	if month == 12 {
		return year + 1
	}
	return year
}
