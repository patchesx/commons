package admintempl

import (
	"fmt"
	"strconv"

	"commons/store"
)

type ResourceView struct {
	ID          string
	Title       string
	URL         string
	Category    string
	Description string
	Position    int
}

templ ResourcesPage(resources []store.Resource, total, page, totalPages int, categories []store.ResourceCategory, permissions []store.Permission) {
	@Layout("Resources", "/admin/resources") {
		<div x-data="{ addMode: '' }">
			<div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
				<h1 class="title is-4 mb-0">Resources</h1>
				<button
					x-on:click="addMode = addMode ? '' : 'select'"
					:aria-expanded="addMode !== ''"
					class="button is-primary is-small"
				>+ Add resource</button>
			</div>
			@PageHelp() {
				The library of videos and links members can browse in Slack. Add a resource by uploading a video or entering a URL. Categories help members find what they need.
			}
			<div x-show="addMode !== ''" style="display:none" class="box mb-4">
				<!-- Mode selector -->
				<div x-show="addMode === 'select'" class="columns">
					<div class="column">
						<button
							x-on:click="addMode = 'upload'"
							class="box has-text-centered is-fullwidth"
							style="cursor: pointer; border: 2px solid var(--bulma-border)"
						>
							<p class="has-text-weight-semibold">Upload Video</p>
							<p class="is-size-7 has-text-grey mt-1">Upload an MP4 to YouTube or Vimeo</p>
						</button>
					</div>
					<div class="column">
						<button
							x-on:click="addMode = 'resource'"
							class="box has-text-centered is-fullwidth"
							style="cursor: pointer; border: 2px solid var(--bulma-border)"
						>
							<p class="has-text-weight-semibold">Add Link Resource</p>
							<p class="is-size-7 has-text-grey mt-1">Add a resource with a URL</p>
						</button>
					</div>
				</div>
				<!-- Video upload form -->
				<div x-show="addMode === 'upload'" x-data="{ platform: 'youtube' }">
					<div class="is-flex is-justify-content-space-between is-align-items-center mb-4">
						<h2 class="title is-6 mb-0">Upload Video</h2>
						<button x-on:click="addMode = 'select'" class="button is-ghost is-small has-text-grey px-0">← Back</button>
					</div>
					<form
						:hx-post="platform === 'vimeo' ? '/api/vimeo/upload' : '/api/youtube/upload'"
						hx-encoding="multipart/form-data"
						hx-swap="none"
						hx-on:htmx:after-request="if(event.detail.successful) { addMode = ''; htmx.ajax('GET', '/admin/fragments/resources-table', {target: '#resources-table', swap: 'outerHTML'}) } else { document.getElementById('resources-upload-result').textContent = 'Upload failed. Check credentials.' }"
					>
						<div class="field">
							<label class="label is-small">Platform</label>
							<div class="control is-flex" style="gap: 1rem">
								<label class="is-flex is-align-items-center is-size-6" style="gap: 0.375rem; cursor: pointer">
									<input type="radio" name="upload-platform" value="youtube" x-model="platform"/>
									YouTube
								</label>
								<label class="is-flex is-align-items-center is-size-6" style="gap: 0.375rem; cursor: pointer">
									<input type="radio" name="upload-platform" value="vimeo" x-model="platform"/>
									Vimeo
								</label>
							</div>
						</div>
						<div class="field">
							<label for="upload-file" class="label is-small">Video file <span class="has-text-danger">*</span></label>
							<div class="control">
								<input id="upload-file" type="file" name="file" accept="video/*" required class="input is-small"/>
							</div>
						</div>
						<div class="field">
							<label for="upload-title" class="label is-small">Title <span class="has-text-danger">*</span></label>
							<div class="control">
								<input id="upload-title" type="text" name="title" required placeholder="Recording title" class="input is-small"/>
							</div>
						</div>
						<div class="field">
							<label for="upload-category" class="label is-small">Category <span class="has-text-danger">*</span></label>
							<div class="control">
								<div class="select is-small is-fullwidth">
									<select id="upload-category" name="category" required>
										<option value="">— select category —</option>
										for _, cat := range categories {
											<option value={ cat.Name }>{ cat.Name }</option>
										}
									</select>
								</div>
							</div>
						</div>
						<div class="field">
							<label for="upload-desc" class="label is-small">Description</label>
							<div class="control">
								<textarea id="upload-desc" name="description" rows="2" class="textarea is-small"></textarea>
							</div>
						</div>
						<div x-show="platform === 'youtube'" class="field">
							<label for="upload-transcript" class="label is-small">Transcript (.vtt, optional)</label>
							<div class="control">
								<input id="upload-transcript" type="file" name="transcript" accept=".vtt" class="input is-small"/>
							</div>
						</div>
						<div id="resources-upload-result" class="help is-danger"></div>
						<div class="field is-grouped">
							<div class="control">
								<button type="submit" class="button is-primary is-small">Upload</button>
							</div>
							<div class="control">
								<button type="button" x-on:click="addMode = ''" class="button is-small">Cancel</button>
							</div>
						</div>
					</form>
				</div>
				<!-- Add link resource form -->
				<div x-show="addMode === 'resource'">
					<div class="is-flex is-justify-content-space-between is-align-items-center mb-4">
						<h2 class="title is-6 mb-0">Add Resource</h2>
						<button x-on:click="addMode = 'select'" class="button is-ghost is-small has-text-grey px-0">← Back</button>
					</div>
					<form
						hx-post="/admin/fragments/resources"
						hx-swap="none"
						hx-on:htmx:after-request="if(event.detail.successful) { addMode = ''; htmx.ajax('GET', '/admin/fragments/resources-table', {target: '#resources-table', swap: 'outerHTML'}) }"
					>
						<div class="field">
							<label for="res-title" class="label is-small">Title <span class="has-text-danger">*</span></label>
							<div class="control">
								<input id="res-title" type="text" name="title" required placeholder="Resource title" class="input is-small"/>
							</div>
						</div>
						<div class="field">
							<label for="res-url" class="label is-small">URL <span class="has-text-danger">*</span></label>
							<div class="control">
								<input id="res-url" type="url" name="url" required placeholder="https://..." class="input is-small"/>
							</div>
						</div>
						<div class="field">
							<label for="res-cat" class="label is-small">Category <span class="has-text-danger">*</span></label>
							<div class="control">
								<div class="select is-small is-fullwidth">
									<select id="res-cat" name="category" required>
										<option value="">— select category —</option>
										for _, cat := range categories {
											<option value={ cat.Name }>{ cat.Name }</option>
										}
									</select>
								</div>
							</div>
						</div>
						<div class="field">
							<label for="res-desc" class="label is-small">Description</label>
							<div class="control">
								<textarea id="res-desc" name="description" rows="2" class="textarea is-small"></textarea>
							</div>
						</div>
						<div class="field is-grouped">
							<div class="control">
								<button type="submit" class="button is-primary is-small">Add</button>
							</div>
							<div class="control">
								<button type="button" x-on:click="addMode = ''" class="button is-small">Cancel</button>
							</div>
						</div>
					</form>
				</div>
			</div>
			@ResourcesTable(resources, total, page, totalPages, categories)
			@ManageCategoriesSection(categories, permissions)
		</div>
		<dialog id="resources-modal" aria-labelledby="resources-modal-title" style="width: 100%; max-width: 28rem; max-height: 90dvh; overflow-y: auto; padding: 0; border: none; border-radius: 0.5rem"></dialog>
	}
}

templ ResourcesTable(resources []store.Resource, total, page, totalPages int, categories []store.ResourceCategory) {
	<div id="resources-table">
		<div class="card mb-4">
			<div class="table-container">
				<table class="table is-fullwidth is-hoverable is-narrow mb-0">
					<thead>
						<tr>
							<th>Title</th>
							<th class="is-hidden-mobile">Category</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						if len(resources) == 0 {
							<tr>
								<td colspan="3" class="has-text-centered py-5">
									@EmptyState("No resources yet. Add one above.")
								</td>
							</tr>
						}
						for _, r := range resources {
							<tr>
								<td>
									<div class="has-text-weight-semibold">
										<a href={ templ.URL(r.URL) } target="_blank" class="has-text-link">{ r.Title }</a>
									</div>
									if r.Description != nil && *r.Description != "" {
										<div class="is-size-7 has-text-grey mt-1">{ *r.Description }</div>
									}
									<div class="is-hidden-tablet is-size-7 has-text-grey mt-1">{ r.Category }</div>
								</td>
								<td class="is-hidden-mobile is-size-7 has-text-grey">{ r.Category }</td>
								<td class="has-text-right" style="white-space: nowrap">
									<div class="buttons are-small mb-0 is-justify-content-flex-end" style="gap: 0.25rem">
										<button
											hx-get={ "/admin/fragments/resources/" + r.ID + "/edit-modal" }
											hx-target="#resources-modal"
											hx-swap="innerHTML"
											hx-on:htmx:after-request="document.getElementById('resources-modal').showModal()"
											class="button is-small is-outlined is-link"
										>Edit</button>
										<span x-data="{ confirming: false }">
											<button
												x-show="!confirming"
												x-on:click.stop="confirming = true"
												class="button is-small is-outlined is-danger"
											>Delete</button>
											<span x-show="confirming" style="display:none">
												<button
													x-on:click.stop
													hx-delete={ "/admin/fragments/resources/" + r.ID }
													hx-swap="none"
													hx-on:htmx:after-request="if(event.detail.successful) { confirming = false; htmx.ajax('GET', '/admin/fragments/resources-table', {target: '#resources-table', swap: 'outerHTML'}) }"
													class="button is-small is-danger"
												>Confirm</button>
												<button
													x-on:click.stop="confirming = false"
													class="button is-small"
												>Cancel</button>
											</span>
										</span>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			@PaginationNav(page, totalPages,
				fmt.Sprintf("/admin/fragments/resources-table?page=%d", page-1),
				fmt.Sprintf("/admin/fragments/resources-table?page=%d", page+1),
				"resources-table") {
				<span class="is-size-7 has-text-grey">{ strconv.Itoa(total) } resources</span>
			}
		</div>
	</div>
}

templ EditResourceModal(r store.Resource, categories []store.ResourceCategory, errMsg string) {
	<div class="box">
		<h2 id="resources-modal-title" class="title is-5 mb-4">Edit Resource</h2>
		<form
			hx-put={ "/admin/fragments/resources/" + r.ID }
			hx-target="#resources-modal"
			hx-swap="innerHTML"
		>
			@AlertBox(errMsg, "error")
			<div class="field">
				<label for="edit-res-title" class="label is-small">Title</label>
				<div class="control">
					<input id="edit-res-title" type="text" name="title" value={ r.Title } required class="input is-small"/>
				</div>
			</div>
			<div class="field">
				<label for="edit-res-url" class="label is-small">URL</label>
				<div class="control">
					<input id="edit-res-url" type="url" name="url" value={ r.URL } required class="input is-small"/>
				</div>
			</div>
			<div class="field">
				<label for="edit-res-cat" class="label is-small">Category</label>
				<div class="control">
					<div class="select is-small is-fullwidth">
						<select id="edit-res-cat" name="category" required>
							for _, cat := range categories {
								<option value={ cat.Name } selected?={ r.Category == cat.Name }>{ cat.Name }</option>
							}
						</select>
					</div>
				</div>
			</div>
			<div class="field">
				<label for="edit-res-desc" class="label is-small">Description</label>
				<div class="control">
					<textarea id="edit-res-desc" name="description" rows="2" class="textarea is-small">
						if r.Description != nil {
							{ *r.Description }
						}
					</textarea>
				</div>
			</div>
			<div class="field is-grouped is-grouped-right">
				<div class="control">
					<button type="button" onclick="document.getElementById('resources-modal').close()" class="button is-small">Cancel</button>
				</div>
				<div class="control">
					<button type="submit" class="button is-primary is-small">Save</button>
				</div>
			</div>
		</form>
	</div>
}

templ ManageCategoriesSection(categories []store.ResourceCategory, permissions []store.Permission) {
	<div x-data="{ open: false }" class="box">
		<button
			x-on:click="open = !open"
			:aria-expanded="open"
			class="is-flex is-justify-content-space-between is-align-items-center is-fullwidth has-text-left"
			style="background: none; border: none; cursor: pointer; padding: 0"
		>
			<span class="has-text-weight-semibold">Manage Categories</span>
			<svg x-bind:class="open ? 'rotate-180' : ''" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="transition: transform 0.2s; flex-shrink: 0">
				<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
			</svg>
		</button>
		<div x-show="open" style="display:none" class="mt-4">
			for _, cat := range categories {
				<div class="is-flex is-align-items-center py-2" style="gap: 0.5rem; border-bottom: 1px solid var(--bulma-border)">
					<form
						hx-patch={ "/admin/fragments/resource-categories/" + cat.ID }
						hx-swap="none"
						hx-on:htmx:after-request="if(event.detail.successful) location.reload()"
						class="is-flex is-align-items-center"
						style="gap: 0.5rem; flex: 1"
					>
						<div class="control" style="flex: 1">
							<input type="text" name="name" value={ cat.Name } class="input is-small"/>
						</div>
						<div class="control">
							<div class="select is-small">
								<select name="permission">
									<option value="">No extra permission</option>
									for _, p := range permissions {
										if cat.RequiredPermission != nil {
											<option value={ p.Key } selected?={ *cat.RequiredPermission == p.Key }>{ p.Key }</option>
										} else {
											<option value={ p.Key }>{ p.Key }</option>
										}
									}
								</select>
							</div>
						</div>
						<div class="control">
							<button type="submit" class="button is-small is-outlined is-link">Save</button>
						</div>
					</form>
					<span x-data="{ confirming: false }">
						<button
							x-show="!confirming"
							x-on:click.stop="confirming = true"
							class="button is-small is-outlined is-danger"
						>Delete</button>
						<span :class="{ 'is-flex': confirming, 'is-hidden': !confirming }" style="gap: 0.25rem">
							<button
								x-on:click.stop
								hx-delete={ "/admin/fragments/resource-categories/" + cat.ID }
								hx-swap="none"
								hx-on:htmx:after-request="if(event.detail.successful) location.reload()"
								class="button is-small is-danger"
							>Confirm</button>
							<button x-on:click.stop="confirming = false" class="button is-small">Cancel</button>
						</span>
					</span>
				</div>
			}
			<form
				hx-post="/admin/fragments/resource-categories"
				hx-swap="none"
				hx-on:htmx:after-request="if(event.detail.successful) { this.reset(); location.reload() }"
				class="is-flex mt-3"
				style="gap: 0.5rem"
			>
				<div class="control" style="flex: 1">
					<input type="text" name="name" placeholder="New category name" required class="input is-small"/>
				</div>
				<div class="control">
					<button type="submit" class="button is-primary is-small">Add</button>
				</div>
			</form>
		</div>
	</div>
}
