package admintempl

import (
	"commons/permissions"
	"commons/store"
	"time"
)

type HomePageData struct {
	DisplayName  string
	QuickLinks   []store.QuickLink
	Events       []store.CalendarEvent
	Announcement string
	Permissions  []string
	UnreadCount  int
}

templ HomePage(data HomePageData) {
	@PortalLayout("Home", "/", data.DisplayName, FilteredPortalNavItems(data.Permissions), data.UnreadCount) {
		<div class="container" style="max-width: 42rem; padding: 0.5rem 1rem"
			x-data="{ modalOpen: false }"
			x-on:keydown.escape.window="modalOpen = false"
		>
			if data.Announcement != "" {
				<div class="notification is-info mb-4">
					{ data.Announcement }
				</div>
			}
			<div class="box mb-4">
				<p class="is-size-7 has-text-grey mb-1">{ homeToday() }</p>
				<h1 class="title is-5 mb-0">
					if data.DisplayName != "" {
						Welcome, { data.DisplayName }
					} else {
						Welcome
					}
				</h1>
			</div>
			if hasPermission(data.Permissions, permissions.QuickLinksView) && len(data.QuickLinks) > 0 {
				<section class="mb-4">
					<p class="is-size-7 has-text-weight-semibold has-text-grey mb-2" style="text-transform: uppercase; letter-spacing: 0.05em">Quick Links</p>
					<div class="box p-0">
						for _, link := range data.QuickLinks {
							<a
								href={ templ.URL(link.URL) }
								target="_blank"
								rel="noopener noreferrer"
								class="is-flex is-justify-content-space-between is-align-items-center px-4 py-3"
								style="border-bottom: 1px solid var(--bulma-border); text-decoration: none; color: inherit"
							>
								<span class="has-text-weight-semibold">{ link.Label }</span>
								<span class="is-size-7 has-text-grey">↗</span>
							</a>
						}
					</div>
				</section>
			}
			if hasPermission(data.Permissions, permissions.CalendarView) && len(data.Events) > 0 {
				<section class="mb-4">
					<div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
						<p class="is-size-7 has-text-weight-semibold has-text-grey" style="text-transform: uppercase; letter-spacing: 0.05em">Upcoming Events</p>
						<button
							hx-get="/fragments/calendar-events"
							hx-target="#portal-modal-content"
							hx-swap="innerHTML"
							x-on:click="modalOpen = true"
							class="button is-ghost is-small has-text-link px-0"
						>View all →</button>
					</div>
					<div class="box p-0">
						for _, ev := range data.Events {
							<div class="px-4 py-3" style="border-bottom: 1px solid var(--bulma-border)">
								<p class="has-text-weight-semibold is-size-6">{ ev.Title }</p>
								<p class="is-size-7 has-text-grey mt-1">{ homeFormatEvent(ev) }</p>
							</div>
						}
					</div>
				</section>
			}
			<div class="columns is-multiline">
				if hasPermission(data.Permissions, permissions.WorkItemsCreate) {
					<div class="column is-half">
						<button
							hx-get="/fragments/report-issue"
							hx-target="#portal-modal-content"
							hx-swap="innerHTML"
							x-on:click="modalOpen = true"
							class="box is-fullwidth has-text-left"
							style="cursor: pointer; border: none"
						>
							<p class="has-text-weight-semibold">Report Issue</p>
							<p class="is-size-7 has-text-grey mt-1">Submit a bug or feature request</p>
						</button>
					</div>
				}
				if hasPermission(data.Permissions, permissions.MeetingsSchedule) {
					<div class="column is-half">
						<button
							hx-get="/fragments/schedule-meeting"
							hx-target="#portal-modal-content"
							hx-swap="innerHTML"
							x-on:click="modalOpen = true"
							class="box is-fullwidth has-text-left"
							style="cursor: pointer; border: none"
						>
							<p class="has-text-weight-semibold">Schedule Meeting</p>
							<p class="is-size-7 has-text-grey mt-1">Create a new meeting</p>
						</button>
					</div>
				}
				if hasPermission(data.Permissions, permissions.MeetingsManage) {
					<div class="column is-half">
						<button
							hx-get="/fragments/manage-meetings"
							hx-target="#portal-modal-content"
							hx-swap="innerHTML"
							x-on:click="modalOpen = true"
							class="box is-fullwidth has-text-left"
							style="cursor: pointer; border: none"
						>
							<p class="has-text-weight-semibold">Manage Meetings</p>
							<p class="is-size-7 has-text-grey mt-1">View and edit scheduled meetings</p>
						</button>
					</div>
				}
				<div
					x-show="modalOpen"
					style="position: fixed; inset: 0; z-index: 50; display: flex; align-items: center; justify-content: center"
					x-cloak
				>
					<div class="modal is-active">
						<div class="modal-background" x-on:click="modalOpen = false"></div>
						<div class="modal-content" style="max-height: 80vh; overflow: auto">
							<div class="box" id="portal-modal-content"></div>
						</div>
						<button class="modal-close is-large" aria-label="close" x-on:click="modalOpen = false"></button>
					</div>
				</div>
			</div>
		</div>
	}
}

templ CalendarEventsFragment(events []store.CalendarEvent) {
	<div>
		<p class="has-text-weight-semibold mb-3">Upcoming Events — Next 14 Days</p>
		if len(events) == 0 {
			<p class="has-text-grey is-size-7">No upcoming events in the next 14 days.</p>
		} else {
			for _, ev := range events {
				<div class="py-2" style="border-bottom: 1px solid var(--bulma-border)">
					<p class="has-text-weight-semibold is-size-6">{ ev.Title }</p>
					<p class="is-size-7 has-text-grey mt-1">{ homeFormatEvent(ev) }</p>
					if ev.Location != nil && *ev.Location != "" {
						<p class="is-size-7 has-text-grey">{ *ev.Location }</p>
					}
				</div>
			}
		}
	</div>
}

func homeToday() string {
	return time.Now().Format("Monday, January 2")
}

func homeFormatEvent(ev store.CalendarEvent) string {
	d := ev.StartTime.Format("Mon, Jan 2")
	if ev.AllDay {
		return d
	}
	return d + " · " + ev.StartTime.Format("3:04 PM")
}
