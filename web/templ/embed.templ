package admintempl

import (
	"fmt"
	"strconv"
	"time"

	"commons/store"
)

// embedDetailsToggle maps the details query param to AgendaList's compact mode:
// details=1 (default) renders the full layout with description toggles;
// details=0 renders the compact layout.

// EmbedCalendarPage is the public, standalone calendar page served at
// /embed/{slug} for iframe embedding: minimal shell (no admin chrome), bulma
// styling only, agenda or month view, everything read-only.
templ EmbedCalendarPage(cal store.Calendar, view string, details bool, agendaDays []AgendaDay, colors map[string]string, year, month int, grid []CalGridCell, occs []store.EventOccurrence, loc *time.Location) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ cal.Name }</title>
			<link rel="stylesheet" href={ templ.URL(AssetURL("bulma.min.css")) }/>
			<link rel="stylesheet" href={ templ.URL(AssetURL("app.css")) }/>
			<style>body { padding: 0.75rem; background: var(--bulma-scheme-main);}</style>
		</head>
		<body>
			<div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
				<h1 class="title is-5 mb-0">{ cal.Name }</h1>
				<div class="tags has-addons">
					<span class="tag is-small">{ viewLabel(view) }</span>
				</div>
			</div>
			if view == "month" {
				@EmbedMonth(cal.Slug, year, month, grid, occs, loc)
			} else {
				if len(agendaDays) == 0 {
					<p class="has-text-grey is-size-7 has-text-centered py-4">No upcoming events.</p>
				} else {
					@AgendaList(agendaDays, colors, !details, "", true)
				}
			}
		</body>
	</html>
}

// EmbedMonth renders the static read-only month grid with plain-link paging.
templ EmbedMonth(slug string, year, month int, grid []CalGridCell, occs []store.EventOccurrence, loc *time.Location) {
	<div>
		<div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
			<a
				href={ templ.URL(embedMonthURL(slug, prevYear(year, month), prevMonth(month))) }
				aria-label="Previous month"
				class="button is-ghost is-size-4 px-3"
			>‹</a>
			<span class="has-text-weight-semibold">{ monthLabel(year, month) }</span>
			<a
				href={ templ.URL(embedMonthURL(slug, nextYear(year, month), nextMonth(month))) }
				aria-label="Next month"
				class="button is-ghost is-size-4 px-3"
			>›</a>
		</div>
		<div style="display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; margin-bottom: 0.25rem">
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Sun</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Mon</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Tue</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Wed</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Thu</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Fri</div>
			<div class="is-size-7 has-text-weight-semibold has-text-grey">Sat</div>
		</div>
		<div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; background: var(--bulma-border); border-radius: 0.375rem; overflow: hidden">
			for _, cell := range grid {
				if cell.Day == 0 {
					<div style="background: var(--bulma-scheme-main-bis); min-height: 2.5rem"></div>
				} else {
					<div style="background: var(--bulma-scheme-main); min-height: 2.5rem; padding: 0.25rem">
						<div class="is-size-7 has-text-weight-semibold">{ strconv.Itoa(cell.Day) }</div>
						for _, ev := range eventsOnDate(occs, cell.DateID, loc) {
							<div class="is-size-7" style="background: var(--bulma-primary-light); color: var(--bulma-primary-dark); border-radius: 0.25rem; padding: 0 0.25rem; margin-top: 0.125rem; overflow: hidden">{ ev.Title }</div>
						}
					</div>
				}
			}
		</div>
	</div>
}

func embedMonthURL(slug string, year, month int) string {
	return "/embed/" + slug + "?view=month&year=" + strconv.Itoa(year) + "&month=" + strconv.Itoa(month)
}

func viewLabel(view string) string {
	if view == "month" {
		return "Month"
	}
	return "Agenda"
}

// EmbedBuilderPanel is the admin-side iframe builder: view/range options, a
// live preview, and a copy-paste snippet.
templ EmbedBuilderPanel(slug, calName, base string) {
	<div
		x-data={ fmt.Sprintf(`{
			view: 'agenda', weeks: 4, details: true, height: 600,
			base: %q, slug: %q, calName: %q,
			get src() {
				let s = this.base + '/embed/' + this.slug + '?view=' + this.view
				if (this.view === 'agenda') s += '&weeks=' + this.weeks + '&details=' + (this.details ? '1' : '0')
				return s
			},
			get snippet() {
				return '<iframe src="' + this.src + '" style="border:0" width="100%%" height="' + this.height + '" title="' + this.calName + '" loading="lazy"></iframe>'
			}
		}`, base, slug, calName) }
	>
		<div class="is-flex is-align-items-center is-flex-wrap-wrap mb-2" style="gap: 0.5rem">
			<div class="select is-small">
				<select x-model="view" aria-label="Embed view">
					<option value="agenda">Agenda</option>
					<option value="month">Month</option>
				</select>
			</div>
			<div class="select is-small" x-show="view === 'agenda'" style="display: none">
				<select x-model.number="weeks" aria-label="Weeks shown">
					<option value="1">1 week</option>
					<option value="2">2 weeks</option>
					<option value="4">4 weeks</option>
					<option value="8">8 weeks</option>
					<option value="12">12 weeks</option>
				</select>
			</div>
			<label class="is-size-7" x-show="view === 'agenda'" style="display: none; line-height: 1.9">
				<input type="checkbox" x-model="details"/>
				Show details
			</label>
			<div class="is-flex is-align-items-center" style="gap: 0.25rem">
				<input type="number" min="200" max="2000" step="50" x-model.number="height" class="input is-small" style="width: 5.5rem" aria-label="Embed height (px)"/>
				<span class="is-size-7 has-text-grey">px tall</span>
			</div>
		</div>
		<div class="field mb-2">
			<div class="control">
				<textarea readonly :value="snippet" class="textarea is-small is-family-monospace" rows="3" aria-label="Embed snippet"></textarea>
			</div>
		</div>
		<div class="is-flex is-align-items-center mb-3" style="gap: 0.5rem">
			<button type="button" class="button is-primary is-small" @click="navigator.clipboard.writeText(snippet)">Copy snippet</button>
			<span class="is-size-7 has-text-grey">Anyone with this snippet can view the calendar — same as the public ICS feed.</span>
		</div>
		<p class="is-size-7 has-text-weight-semibold mb-1">Preview</p>
		<iframe
			:src="src"
			:height="height"
			:title="calName"
			style="width: 100%; border: 1px solid var(--bulma-border); border-radius: 0.375rem; background: var(--bulma-scheme-main)"
		></iframe>
	</div>
}
