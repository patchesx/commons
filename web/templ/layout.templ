package admintempl

import "commons/web"

// extraNavItems holds nav items registered by plugins via RegisterNavItem.
var extraNavItems []SidebarItem

// SetExtraNavItems is called once from main.go after all plugins are initialised.
func SetExtraNavItems(items []SidebarItem) {
	extraNavItems = items
}

func adminNavGroups() []SidebarGroup {
	groups := []SidebarGroup{
		{
			Label: "General",
			Items: []SidebarItem{
				{"/admin/docs", "Documentation", ""},
			},
		},
		{
			Label: "Operations",
			Items: []SidebarItem{
				{"/admin/jobs", "Jobs", ""},
				{"/admin/meetings", "Meetings", ""},
				{"/admin/work-items", "Work Items", "/admin/fragments/open-work-items-count"},
				{"/admin/audit", "Audit Log", ""},
				{"/admin/broadcasts", "Broadcasts", ""},
				{"/admin/polls", "Polls", ""},
			},
		},
		{
			Label: "Setup",
			Items: []SidebarItem{
				{"/admin/integrations", "Integrations", ""},
				{"/admin/settings", "Settings", ""},
				{"/admin/triggers", "Triggers", ""},
				{"/admin/roles", "Roles", ""},
				{"/admin/app-home", "App Home", ""},
			},
		},
		{
			Label: "Members",
			Items: []SidebarItem{
				{"/admin/users", "Users", ""},
			},
		},
		{
			Label: "Content",
			Items: []SidebarItem{
				{"/admin/resources", "Resources", ""},
				{"/admin/legislation", "Legislation", ""},
				{"/admin/calendars", "Calendars", ""},
			},
		},
		{
			Label: "Inventory",
			Items: []SidebarItem{
				{"/admin/inventory", "Items", ""},
				{"/admin/inventory/grid", "Grid", ""},
				{"/admin/inventory/fields", "Custom Fields", ""},
				{"/admin/inventory/claims", "Unmatched Claims", "/admin/fragments/inventory/claims-count"},
			},
		},
	}
	if len(extraNavItems) > 0 {
		groups = append(groups, SidebarGroup{Label: "Plugins", Items: extraNavItems})
	}
	return groups
}

func appearanceOrgName(cfg web.AppearanceConfig) string {
	if cfg.OrgName != "" {
		return cfg.OrgName
	}
	return "Admin"
}

templ adminSidebarHeader() {
	<div class="px-4 py-4" style="border-bottom: 1px solid rgba(255,255,255,0.1); flex-shrink: 0">
		if false {
			<a href="/" class="has-text-grey-light is-size-7 is-block mb-1">← Back to portal</a>
		}
		<span class="has-text-white has-text-weight-semibold is-size-5">
			{ appearanceOrgName(web.AppearanceFromContext(ctx)) }
		</span>
	</div>
}

templ adminSidebarFooter() {
	<div class="px-4 py-4" style="border-top: 1px solid rgba(255,255,255,0.1); flex-shrink: 0">
		<a
			href="/change-password"
			class="has-text-grey-lighter is-size-7 is-block mb-2"
		>Change password</a>
		<button
			hx-post="/logout"
			hx-on:htmx:after-request="window.location.href='/login'"
			x-on:click="open = false"
			class="button is-ghost has-text-grey-lighter is-size-7 p-0"
			style="height: auto"
		>Log out</button>
	</div>
}

templ Layout(title string, currentPath string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — { appearanceOrgName(web.AppearanceFromContext(ctx)) }</title>
			<link rel="stylesheet" href={ templ.URL(AssetURL("bulma.min.css")) }/>
			<link rel="stylesheet" href={ templ.URL(AssetURL("app.css")) }/>
			<link rel="stylesheet" href={ templ.URL(AssetURL("phosphor-icons.css")) }/>
			<link rel="stylesheet" href={ templ.URL(AssetURL("phosphor-duotone-icons.css")) }/>
			if appearance := web.AppearanceFromContext(ctx); appearance.FaviconURL != "" {
				<link rel="icon" href={ appearance.FaviconURL }/>
			}
			<!-- Set data-theme before body renders to avoid flash -->
			<script>
				(function(){
					var mq = window.matchMedia('(prefers-color-scheme: dark)');
					function apply(dark) {
						document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
					}
					apply(mq.matches);
					mq.addEventListener('change', function(e){ apply(e.matches); });
				})();

				// Emoji data is shared by every composer on the page and fetched once: the standard set, which is
				// static, and the workspace's custom emoji, which can fail (for example without the emoji:read scope).
				let slackEmojiLoad = null;
				function loadSlackEmoji() {
					if (slackEmojiLoad) return slackEmojiLoad;
					const getJSON = async (url) => {
						const r = await fetch(url);
						const body = await r.json().catch(() => null);
						if (!r.ok) throw new Error((body && body.error) || ('HTTP ' + r.status));
						return body;
					};
					slackEmojiLoad = Promise.all([
						getJSON('/api/slack/emojis/standard').catch(() => []),
						getJSON('/api/slack/emojis').then(custom => ({ custom: custom || [], error: '' }))
							.catch(e => ({ custom: [], error: e.message })),
					]).then(([standard, c]) => {
						const byName = {};
						standard.forEach(x => x.n.forEach(n => { byName[n] = x.e; }));
						return { standard, byName, custom: c.custom, error: c.error };
					});
					return slackEmojiLoad;
				}

				function slackComposer(opts) {
					return {
						tab: 'edit',
						message: opts.message || '',
						users: opts.users || {},
						channels: opts.channels || {},
						actionType: opts.actionType || '',
						recipientSlackId: opts.recipientSlackId || '',

						emojiModalOpen: false,
						emojis: [],
						standard: [],
						emojiByName: {},
						emojiError: '',
						emojisLoaded: false,
						emojiSearch: '',
						emojiTab: 'Smileys & Emotion',
						emojiTabs: [
							{ id: 'custom', label: 'Custom', icon: '' },
							{ id: 'Smileys & Emotion', label: 'Smileys & Emotion', icon: '\u{1F600}' },
							{ id: 'People & Body', label: 'People & Body', icon: '\u{1F44B}' },
							{ id: 'Animals & Nature', label: 'Animals & Nature', icon: '\u{1F43B}' },
							{ id: 'Food & Drink', label: 'Food & Drink', icon: '\u{1F354}' },
							{ id: 'Travel & Places', label: 'Travel & Places', icon: '\u2708\uFE0F' },
							{ id: 'Activities', label: 'Activities', icon: '\u26BD' },
							{ id: 'Objects', label: 'Objects', icon: '\u{1F4A1}' },
							{ id: 'Symbols', label: 'Symbols', icon: '\u2764\uFE0F' },
							{ id: 'Flags', label: 'Flags', icon: '\u{1F3C1}' },
						],

						async init() {
							const d = await loadSlackEmoji();
							this.emojis = d.custom;
							this.standard = d.standard;
							this.emojiByName = d.byName;
							this.emojiError = d.error;
							this.emojisLoaded = true;
						},

						insertMention(text) {
							const ta = this.$refs.msgTextarea;
							const start = ta.selectionStart;
							const end = ta.selectionEnd;
							this.message = this.message.slice(0, start) + text + this.message.slice(end);
							this.$nextTick(() => {
								ta.selectionStart = ta.selectionEnd = start + text.length;
								ta.focus();
							});
						},

						// What the picker shows: the chosen tab, or every match across custom and standard emoji while searching.
						get filteredEmojis() {
							const q = this.emojiSearch.toLowerCase().trim();
							const custom = this.emojis.map(e => ({
								key: 'c:' + e.name, name: e.name, url: e.url || '',
								char: !e.url && e.alias ? (this.emojiByName[e.alias] || '') : '',
							}));
							const std = x => ({ key: 's:' + x.n[0], name: x.n[0], url: '', char: x.e });
							if (!q) {
								if (this.emojiTab === 'custom') return custom;
								return this.standard.filter(x => x.c === this.emojiTab).map(std);
							}
							const hit = s => s.toLowerCase().includes(q);
							return custom.filter(e => hit(e.name))
								.concat(this.standard.filter(x => x.n.some(hit) || x.t.some(hit)).map(std))
								.slice(0, 300);
						},

						openEmojiModal() {
							this.emojiModalOpen = true;
						},

						insertEmoji(name) {
							this.insertMention(':' + name + ':');
							this.emojiModalOpen = false;
							this.emojiSearch = '';
						},

						get previewHtml() {
							const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
							let t = esc(this.message);
							// Extract emojis into placeholders before markdown processing to
							// prevent * _ ~ ` inside emoji names from being mangled.
							const emojiMap = {};
							for (const e of this.emojis) {
								if (e.url) emojiMap[e.name] = e.url;
							}
							const customChars = {};
							for (const e of this.emojis) {
								if (!e.url && e.alias && this.emojiByName[e.alias]) customChars[e.name] = this.emojiByName[e.alias];
							}
							const emojiImgs = [];
							t = t.replace(/:([a-z0-9_+-]+):/g, (match, name) => {
								let html = null;
								if (emojiMap[name]) {
									html = '<img src="' + emojiMap[name] + '" alt=":' + name + ':" style="max-width:1.25rem;max-height:1.25rem;vertical-align:middle">';
								} else if (customChars[name] || this.emojiByName[name]) {
									html = customChars[name] || this.emojiByName[name];
								}
								if (html === null) return match;
								emojiImgs.push(html);
								return '\x00E' + (emojiImgs.length - 1) + '\x00';
							});
							t = t.replace(/&lt;@\{\{user_id\}\}&gt;/g,
								'<span class="slack-mention">@Joining Member</span>');
							const u = this.users;
							t = t.replace(/&lt;@([A-Z0-9]+)&gt;/g, (_, id) =>
								'<span class="slack-mention">@' + esc(u[id] || id) + '</span>');
							const ch = this.channels;
							t = t.replace(/&lt;#([A-Z0-9]+)&gt;/g, (_, id) =>
								'<span class="slack-mention">#' + esc(ch[id] || id) + '</span>');
							t = t.replace(/\*((?:[^*]|\n)+?)\*/g, '<strong>$1</strong>');
							t = t.replace(/_((?:[^_]|\n)+?)_/g, '<em>$1</em>');
							t = t.replace(/~((?:[^~]|\n)+?)~/g, '<del>$1</del>');
							t = t.replace(/`([^`\n]+)`/g, '<code class="slack-code">$1</code>');
							t = t.replace(/\n/g, '<br>');
							// Restore emoji images after markdown processing.
							emojiImgs.forEach((img, idx) => {
								t = t.split('\x00E' + idx + '\x00').join(img);
							});
							return t || '<span class="has-text-grey-light" style="font-style:italic">Nothing to preview</span>';
						}
					};
				}
			</script>
			<script defer src={ templ.URL(AssetURL("alpine.min.js")) }></script>
			<script defer src="/.within.website/x/htmx/htmx.js"></script>
		</head>
		<body>
			@SidebarLayout(
				appearanceOrgName(web.AppearanceFromContext(ctx)),
				currentPath,
				adminNavGroups(),
				adminSidebarHeader(),
				adminSidebarFooter(),
			) {
				<section class="section">
					{ children... }
				</section>
			}
		</body>
	</html>
}
