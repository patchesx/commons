package admintempl

import (
	"encoding/json"
	"fmt"

	"commons/plugin"
)

// SlackComposerOpts configures the SlackMessageComposer component.
type SlackComposerOpts struct {
	FieldName     string
	InitValue     string
	UserMap       map[string]string     // slackID → displayName, used for preview rendering
	Channels      []WHChannel           // channel mention buttons + preview resolution
	PipelineVars  []plugin.DataFieldDef // {{key}} insertion buttons (webhook pipeline context)
	ShowInitiator bool                  // show @Joining Member button (inserts <@{{user_id}}>)
	ShowRecipient bool                  // show @Recipient button (reads recipientSlackId from enclosing scope)
	Standalone    bool                  // true = wrap in own x-data; false = inherit enclosing scope
	Placeholder   string
}

func composerJSONStr(s string) string {
	b, _ := json.Marshal(s)
	return string(b)
}

func composerUsersJSON(m map[string]string) string {
	if m == nil {
		return "{}"
	}
	b, _ := json.Marshal(m)
	return string(b)
}

func composerChannelsJSON(channels []WHChannel) string {
	m := make(map[string]string, len(channels))
	for _, ch := range channels {
		m[ch.ID] = ch.Name
	}
	b, _ := json.Marshal(m)
	return string(b)
}

func composerXData(opts SlackComposerOpts) string {
	return fmt.Sprintf(
		`slackComposer({message:%s,users:%s,channels:%s,actionType:'',recipientSlackId:''})`,
		composerJSONStr(opts.InitValue),
		composerUsersJSON(opts.UserMap),
		composerChannelsJSON(opts.Channels),
	)
}

func composerPlaceholder(opts SlackComposerOpts) string {
	if opts.Placeholder != "" {
		return opts.Placeholder
	}
	return "Your message here…"
}

// SlackMessageComposer renders a Write/Preview message editor with Slack mention
// and pipeline variable insertion buttons. When Standalone is true it provides its
// own x-data scope; otherwise it reads and writes Alpine state from the enclosing scope.
templ SlackMessageComposer(opts SlackComposerOpts) {
	if opts.Standalone {
		<div x-data={ composerXData(opts) }>
			@slackComposerInner(opts)
			@slackEmojiPicker()
		</div>
	} else {
		@slackComposerInner(opts)
		@slackEmojiPicker()
	}
}

templ slackComposerInner(opts SlackComposerOpts) {
	<div class="field">
		<div class="is-flex is-align-items-center mb-1" style="gap: 0.5rem">
			<label class="label is-small mb-0">Message</label>
			<div class="tabs is-small mb-0" style="border-bottom: none">
				<ul style="border-bottom: none">
					<li :class="tab === 'edit' ? 'is-active' : ''">
						<a @click.prevent="tab = 'edit'" class="is-size-7">Write</a>
					</li>
					<li :class="tab === 'preview' ? 'is-active' : ''">
						<a @click.prevent="tab = 'preview'" class="is-size-7">Preview</a>
					</li>
				</ul>
			</div>
		</div>
		<div class="control" x-show="tab === 'edit'">
			<textarea
				x-ref="msgTextarea"
				x-model="message"
				name={ opts.FieldName }
				rows="4"
				placeholder={ composerPlaceholder(opts) }
				class="textarea is-small"
			></textarea>
		</div>
		<div
			x-show="tab === 'preview'"
			x-html="previewHtml"
			class="slack-preview"
			style="display:none"
		></div>
		<div class="is-flex is-flex-wrap-wrap is-align-items-center mt-2" style="gap: 0.35rem">
			<span class="is-size-7 has-text-grey-light">Insert:</span>
			if opts.ShowInitiator {
				<button
					type="button"
					@click={ `insertMention('<@{{user_id}}>')` }
					class="button is-small is-link is-light"
				>{ "@Joining Member" }</button>
			}
			if opts.ShowRecipient {
				<span x-show="actionType === 'send_dm' && recipientSlackId" style="display:none">
					<button
						type="button"
						@click={ `insertMention('<@' + recipientSlackId + '>')` }
						class="button is-small is-link is-light"
					>{ "@Recipient" }</button>
				</span>
			}
			for _, ch := range opts.Channels {
				<button
					type="button"
					@click={ fmt.Sprintf("insertMention('<#%s>')", ch.ID) }
					class="button is-small is-info is-light"
				>#{ ch.Name }</button>
			}
			for _, v := range opts.PipelineVars {
				<button
					type="button"
					class="button is-small is-family-monospace"
					@click={ fmt.Sprintf("insertMention('{{%s}}')", v.Key) }
					title={ v.Label + ": " + v.Description }
				>{ "{{" + v.Key + "}}" }</button>
			}
			<button
				type="button"
				@click="openEmojiModal()"
				class="button is-small is-warning is-light"
			>Add emoji</button>
		</div>
	</div>
}

templ slackEmojiPicker() {
	<div x-show="emojiModalOpen" @keydown.escape.window="emojiModalOpen = false" style="display:none">
		<div class="modal is-active">
			<div class="modal-background" @click="emojiModalOpen = false"></div>
			<div class="modal-content" style="max-width: 30rem; max-height: 70vh; overflow: hidden; margin: 0 auto">
				<div class="box" style="display: flex; flex-direction: column; max-height: 70vh; overflow: hidden">
					<div class="is-flex is-align-items-center is-justify-content-space-between mb-3">
						<h3 class="title is-6 mb-0">Add emoji</h3>
						<button type="button" class="delete" @click="emojiModalOpen = false" aria-label="Close"></button>
					</div>
					<div class="field mb-3">
						<div class="control">
							<input
								type="text"
								x-model="emojiSearch"
								placeholder="Search emojis…"
								class="input is-small"
							>
						</div>
					</div>
					<div style="flex: 1; overflow-y: auto; min-height: 12rem">
						<div x-show="!emojisLoaded" class="has-text-centered has-text-grey-light py-4">
							<span class="is-size-7">Loading…</span>
						</div>
						<div x-show="emojisLoaded && filteredEmojis.length === 0" class="has-text-centered has-text-grey-light py-4">
							<span class="is-size-7">No emojis found</span>
						</div>
						<div class="is-flex is-flex-wrap-wrap" style="gap: 0.25rem">
							<template x-for="e in filteredEmojis" :key="e.name">
								<button
									type="button"
									@click="insertEmoji(e.name)"
									class="button is-small"
									:title="':' + e.name + ':'"
									style="padding: 0.2rem; width: 2rem; height: 2rem; display: flex; align-items: center; justify-content: center"
								>
									<img :src="e.url" :alt="e.name" style="max-width: 1.25rem; max-height: 1.25rem" x-show="e.url">
									<span x-show="!e.url" x-text="e.name.charAt(0).toUpperCase()" class="is-size-7 is-family-monospace"></span>
								</button>
							</template>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}
